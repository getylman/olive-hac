{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-dishes-css\">\n/* v7 skin: donor card geometry on the same 6 real meals (name/mass/kcal/Б-Ж-У verbatim\n   from the meals API — never edit these numbers by hand). Emoji boxes are symbolic, not\n   photography: MCP exposes no dish images and stock photos are banned (implementer handoff). */\n.gs-dishes{display:grid;grid-auto-flow:column;grid-auto-columns:78%;gap:14px;max-width:1200px;\n  margin:30px auto 0;padding:4px 20px 16px;overflow-x:auto;overscroll-behavior-x:contain;\n  -webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory;scroll-padding-left:20px}\n@media (min-width:768px){.gs-dishes{grid-auto-columns:280px}}\n.gs-dish{scroll-snap-align:start;background:#fff;border:2px solid var(--gs7-line,rgba(32,39,26,.12));\n  border-radius:var(--gs-r-card,22px);overflow:hidden;display:flex;flex-direction:column;text-align:left}\n.gs-dish .gs-imgbox{aspect-ratio:16/9}\n.gs-dish .gs-imgbox::before{font-size:44px}\n.gs-dish__body{flex:1;display:flex;flex-direction:column;gap:10px;padding:16px 18px}\n.gs-dish__cat{align-self:flex-start;background:var(--gs7-spring,#DCEBC4);color:var(--gs7-deep,#2C4E28);\n  border-radius:999px;padding:4px 10px;text-transform:uppercase;letter-spacing:.04em;\n  font:700 var(--gs-fs-xs,.75rem)/1.3 var(--gs-text,sans-serif)}\n.gs-dish__name{margin:0;font:600 var(--gs-fs-body,1rem)/1.3 var(--gs-text,sans-serif);color:var(--gs7-ink,#20271A)}\n.gs-dish__kcal{margin-top:auto;font:800 1.75rem/1 var(--gs-display,system-ui,sans-serif);\n  letter-spacing:-.04em;color:var(--gs7-green,#3F6B39);font-variant-numeric:tabular-nums}\n.gs-dish__kcal small{font:500 var(--gs-fs-sm,.875rem)/1 var(--gs-text,sans-serif);color:var(--gs7-muted,#697260);letter-spacing:0}\n.gs-dish__macros{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:12px 0 0;list-style:none;\n  border-top:1px solid var(--gs7-line,rgba(32,39,26,.12))}\n.gs-dish__macros li{background:var(--gs7-soft,#F4F8EE);border-radius:999px;padding:4px 10px;\n  color:var(--gs7-ink,#20271A);font-variant-numeric:tabular-nums;\n  font:600 var(--gs-fs-sm,.875rem)/1.3 var(--gs-text,sans-serif)}\n.gs-dishes__hint{margin:12px 0 0;font:600 var(--gs-fs-sm,.875rem)/1.4 var(--gs-text,sans-serif);\n  color:var(--gs7-muted,#697260)}\n.gs-dishes__foot{display:flex;justify-content:center;margin-top:24px}\n@media (max-width:560px){.gs-dishes__foot .gs-btn{width:100%}}\n</style>\n<section class=\"gs-sec gs-sec--soft\" id=\"gsDishes\">\n  <div class=\"gs-wrap gs-center\">\n    <h2 class=\"gs-h2\">Что внутри рациона</h2>\n    <p class=\"gs-lead\">Реальные блюда из меню O-live — вес и КБЖУ как в рационе. Все шесть входят в планы 1&nbsp;200 и 1&nbsp;500 ккал.</p>\n    <p class=\"gs-dishes__hint\">6 из 297 блюд меню — листайте вбок →</p>\n  </div>\n  <div class=\"gs-dishes\" role=\"region\" aria-label=\"Примеры блюд из меню\" tabindex=\"0\">\n    <article class=\"gs-dish\"><div class=\"gs-imgbox\" data-emoji=\"🍳\" aria-hidden=\"true\"></div><div class=\"gs-dish__body\">\n      <span class=\"gs-dish__cat\">Завтрак</span>\n      <h3 class=\"gs-dish__name\">Скрембл с индейкой</h3>\n      <div class=\"gs-dish__kcal\">355 ккал <small>· 220 г</small></div>\n      <ul class=\"gs-dish__macros\"><li>Б 28</li><li>Ж 24</li><li>У 6</li></ul>\n    </div></article>\n    <article class=\"gs-dish\"><div class=\"gs-imgbox\" data-emoji=\"🥞\" aria-hidden=\"true\"></div><div class=\"gs-dish__body\">\n      <span class=\"gs-dish__cat\">Завтрак</span>\n      <h3 class=\"gs-dish__name\">Сырники с чиа</h3>\n      <div class=\"gs-dish__kcal\">391 ккал <small>· 185 г</small></div>\n      <ul class=\"gs-dish__macros\"><li>Б 20</li><li>Ж 18</li><li>У 37</li></ul>\n    </div></article>\n    <article class=\"gs-dish\"><div class=\"gs-imgbox\" data-emoji=\"🍗\" aria-hidden=\"true\"></div><div class=\"gs-dish__body\">\n      <span class=\"gs-dish__cat\">Второе</span>\n      <h3 class=\"gs-dish__name\">Куриная грудка с кускусом ПП</h3>\n      <div class=\"gs-dish__kcal\">233 ккал <small>· 327 г</small></div>\n      <ul class=\"gs-dish__macros\"><li>Б 33</li><li>Ж 7</li><li>У 9</li></ul>\n    </div></article>\n    <article class=\"gs-dish\"><div class=\"gs-imgbox\" data-emoji=\"🐟\" aria-hidden=\"true\"></div><div class=\"gs-dish__body\">\n      <span class=\"gs-dish__cat\">Второе</span>\n      <h3 class=\"gs-dish__name\">Нежная семга с овощами гриль</h3>\n      <div class=\"gs-dish__kcal\">376 ккал <small>· 305 г</small></div>\n      <ul class=\"gs-dish__macros\"><li>Б 25</li><li>Ж 25</li><li>У 11</li></ul>\n    </div></article>\n    <article class=\"gs-dish\"><div class=\"gs-imgbox\" data-emoji=\"🍲\" aria-hidden=\"true\"></div><div class=\"gs-dish__body\">\n      <span class=\"gs-dish__cat\">Суп</span>\n      <h3 class=\"gs-dish__name\">Суп Минестроне</h3>\n      <div class=\"gs-dish__kcal\">246 ккал <small>· 277 г</small></div>\n      <ul class=\"gs-dish__macros\"><li>Б 17</li><li>Ж 9</li><li>У 24</li></ul>\n    </div></article>\n    <article class=\"gs-dish\"><div class=\"gs-imgbox\" data-emoji=\"🍫\" aria-hidden=\"true\"></div><div class=\"gs-dish__body\">\n      <span class=\"gs-dish__cat\">Десерт</span>\n      <h3 class=\"gs-dish__name\">Брауни без сахара</h3>\n      <div class=\"gs-dish__kcal\">168 ккал <small>· 45 г</small></div>\n      <ul class=\"gs-dish__macros\"><li>Б 9</li><li>Ж 10</li><li>У 11</li></ul>\n    </div></article>\n  </div>\n  <div class=\"gs-wrap gs-dishes__foot\">\n    <a class=\"gs-btn gs-btn--ghost gs-btn--big\" href=\"#orderFunnel\" data-cta=\"dishes-order\">Собрать рацион</a>\n  </div>\n</section>"
  }
}
