{
  "type": "html",
  "props": {
    "content": "<style>\n.gs-dishes-sec{background:var(--l-bg-soft,#F2F2F2);padding:var(--gs-sp-7,48px) 0;overflow-x:hidden}\n.gs-dishes-sec__in{max-width:1120px;margin:0 auto;padding:0 20px}\n.gs-dishes-sec .gs-dishes__title{margin-bottom:var(--gs-sp-4,16px)}\n.gs-dishes__sub{margin:0 auto;max-width:56ch;text-align:center;color:var(--l-ink,#181717);font:500 var(--gs-fs-body,1rem)/1.5 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif)}\n.gs-dishes__hint{margin:var(--gs-sp-3,12px) 0 0;text-align:center;color:var(--l-muted,#5E5E5E);font:500 var(--gs-fs-sm,.875rem)/1.4 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif)}\n.gs-dishes{display:grid;grid-auto-flow:column;grid-auto-columns:78%;gap:var(--gs-sp-3,12px);max-width:1120px;margin:var(--gs-sp-5,24px) auto 0;padding:4px 20px 16px;overflow-x:auto;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory;scroll-padding-left:20px}\n@media (min-width:768px){.gs-dishes{grid-auto-columns:280px}}\n.gs-dish{scroll-snap-align:start;background:#fff;border-radius:var(--gs-r-card,16px);box-shadow:var(--gs-sh-card,0 10px 30px rgba(0,0,0,.08));display:flex;flex-direction:column;min-height:190px}\n.gs-dish__body{flex:1;display:flex;flex-direction:column;gap:var(--gs-sp-2,8px);padding:var(--gs-sp-4,16px)}\n.gs-dish__cat{align-self:flex-start;background:var(--l-bg-lime,#EAF3DF);color:var(--l-green-dark,#194536);border-radius:var(--gs-r-pill,999px);padding:4px 10px;text-transform:uppercase;letter-spacing:.04em;font:700 var(--gs-fs-xs,.75rem)/1.3 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif)}\n.gs-dish__name{margin:0;color:var(--l-ink,#181717);font:500 var(--gs-fs-body,1rem)/1.3 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif)}\n.gs-dish__kcal{margin-top:auto;color:var(--l-green-dark,#194536);font-variant-numeric:tabular-nums;font:700 var(--gs-fs-h3,1.3125rem)/1 var(--gs-display,\"Loos Wide\",Arial,sans-serif)}\n.gs-dish__kcal small{color:var(--l-muted,#5E5E5E);font:500 var(--gs-fs-sm,.875rem)/1 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif)}\n.gs-dish__macros{display:flex;flex-wrap:wrap;gap:var(--gs-sp-2,8px);margin:0;padding:var(--gs-sp-3,12px) 0 0;list-style:none;border-top:1px solid #E6E6E6}\n.gs-dish__macros li{background:var(--l-bg-soft,#F2F2F2);border-radius:var(--gs-r-pill,999px);padding:4px 10px;color:var(--l-ink,#181717);font-variant-numeric:tabular-nums;font:500 var(--gs-fs-sm,.875rem)/1.3 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif)}\n.gs-dishes__foot{display:flex;justify-content:center;max-width:1120px;margin:var(--gs-sp-5,24px) auto 0;padding:0 20px}\n.gs-dishes__cta{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:14px 32px;background:#fff;color:var(--l-green-dark,#194536);border:2px solid var(--l-green-dark,#194536);border-radius:var(--gs-r-pill,999px);text-decoration:none;transition:background .2s ease,color .2s ease;font:500 var(--gs-fs-lead,1.125rem)/1.05 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif)}\n.gs-dishes__cta:hover,.gs-dishes__cta:focus-visible{background:var(--l-green-dark,#194536);color:#fff}\n@media (max-width:560px){.gs-dishes__cta{width:100%}}\n@media (prefers-reduced-motion:reduce){.gs-dishes__cta{transition:none}}\n</style>\n<section class=\"gs-dishes-sec\">\n  <div class=\"gs-dishes-sec__in\">\n    <h2 class=\"l-title gs-dishes__title\">Что внутри рациона</h2>\n    <p class=\"gs-dishes__sub\">Реальные блюда из меню O-live — вес и КБЖУ как в рационе. Все шесть входят в планы 1&nbsp;200 и 1&nbsp;500 ккал.</p>\n    <p class=\"gs-dishes__hint\">6 из 297 блюд меню — листайте вбок →</p>\n  </div>\n  <div class=\"gs-dishes\" role=\"region\" aria-label=\"Примеры блюд из меню\" tabindex=\"0\">\n    <article class=\"gs-dish\"><div class=\"gs-dish__body\">\n      <span class=\"gs-dish__cat\">Завтрак</span>\n      <h3 class=\"gs-dish__name\">Скрембл с индейкой</h3>\n      <div class=\"gs-dish__kcal\">355 ккал <small>· 220 г</small></div>\n      <ul class=\"gs-dish__macros\"><li>Б 28</li><li>Ж 24</li><li>У 6</li></ul>\n    </div></article>\n    <article class=\"gs-dish\"><div class=\"gs-dish__body\">\n      <span class=\"gs-dish__cat\">Завтрак</span>\n      <h3 class=\"gs-dish__name\">Сырники с чиа</h3>\n      <div class=\"gs-dish__kcal\">391 ккал <small>· 185 г</small></div>\n      <ul class=\"gs-dish__macros\"><li>Б 20</li><li>Ж 18</li><li>У 37</li></ul>\n    </div></article>\n    <article class=\"gs-dish\"><div class=\"gs-dish__body\">\n      <span class=\"gs-dish__cat\">Второе</span>\n      <h3 class=\"gs-dish__name\">Куриная грудка с кускусом ПП</h3>\n      <div class=\"gs-dish__kcal\">233 ккал <small>· 327 г</small></div>\n      <ul class=\"gs-dish__macros\"><li>Б 33</li><li>Ж 7</li><li>У 9</li></ul>\n    </div></article>\n    <article class=\"gs-dish\"><div class=\"gs-dish__body\">\n      <span class=\"gs-dish__cat\">Второе</span>\n      <h3 class=\"gs-dish__name\">Нежная семга с овощами гриль</h3>\n      <div class=\"gs-dish__kcal\">376 ккал <small>· 305 г</small></div>\n      <ul class=\"gs-dish__macros\"><li>Б 25</li><li>Ж 25</li><li>У 11</li></ul>\n    </div></article>\n    <article class=\"gs-dish\"><div class=\"gs-dish__body\">\n      <span class=\"gs-dish__cat\">Суп</span>\n      <h3 class=\"gs-dish__name\">Суп Минестроне</h3>\n      <div class=\"gs-dish__kcal\">246 ккал <small>· 277 г</small></div>\n      <ul class=\"gs-dish__macros\"><li>Б 17</li><li>Ж 9</li><li>У 24</li></ul>\n    </div></article>\n    <article class=\"gs-dish\"><div class=\"gs-dish__body\">\n      <span class=\"gs-dish__cat\">Десерт</span>\n      <h3 class=\"gs-dish__name\">Брауни без сахара</h3>\n      <div class=\"gs-dish__kcal\">168 ккал <small>· 45 г</small></div>\n      <ul class=\"gs-dish__macros\"><li>Б 9</li><li>Ж 10</li><li>У 11</li></ul>\n    </div></article>\n  </div>\n  <div class=\"gs-dishes__foot\">\n    <a class=\"gs-dishes__cta\" href=\"#orderFunnel\" data-cta=\"dishes-order\">Собрать рацион</a>\n  </div>\n</section>\n"
  }
