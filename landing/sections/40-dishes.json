{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-dishes-css\">\n/* Dish carousel. Photos are the real ones the funnel itself shows: GET\n   /api/meal-plans/<plan>/day/<iso> returns each meal with an `images` array\n   (order-funnel.js mealImages()), which the MCP `meals` tool does not expose. Names, mass,\n   kcal and Б/Ж/У come from the `meals` API and agree with the day endpoint dish for dish;\n   all eight sit in every one of the four rations. Nothing here is hand-edited.\n   Paths are root-relative so they stay same-origin for validate.py. Nothing here is lazy:\n   the carousel is a horizontal scroller, so a lazy card is one swipe away from being looked\n   at and would show up blank. All eight (about 815 KB together, each curl-verified 200) load\n   with the page; the two lead cards carry fetchpriority=high and the rest take default\n   priority so they queue behind the hero rather than competing with it. Every img carries\n   width/height, so the row reserves its space before the pictures arrive. */\n.gs-car{max-width:1200px;margin:26px auto 0}\n.gs-car__head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 20px 14px}\n.gs-car__count{font:700 var(--gs-fs-sm,.9375rem)/1.35 var(--gs-text,sans-serif);color:var(--gs7-muted,#4E5748)}\n.gs-car__nav{display:flex;gap:8px}\n.gs-car__btn{width:44px;height:44px;border-radius:50%;border:1.5px solid var(--gs7-green,#3F6B39);\n  background:#fff;color:var(--gs7-green,#3F6B39);display:inline-flex;align-items:center;\n  justify-content:center;cursor:pointer;padding:0}\n.gs-car__btn:disabled{opacity:.35;cursor:default}\n.gs-dishes{display:flex;gap:14px;padding:4px 20px 18px;overflow-x:auto;overscroll-behavior-x:contain;\n  -webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory;scroll-padding-left:20px}\n.gs-dish{flex:0 0 auto;width:258px;scroll-snap-align:start;background:#fff;border:1px solid #E3E8DE;\n  border-radius:18px;overflow:hidden;display:flex;flex-direction:column;text-align:left}\n.gs-dish__img{display:block;width:100%;height:auto;aspect-ratio:340/250;object-fit:cover;background:#fff}\n.gs-dish__body{flex:1;display:flex;flex-direction:column;gap:8px;padding:14px 15px 16px}\n.gs-dish__cat{align-self:flex-start;background:var(--gs7-spring,#DCEBC4);color:var(--gs7-deep,#2C4E28);\n  border-radius:999px;padding:3px 10px;text-transform:uppercase;letter-spacing:.04em;\n  font:700 11px/1.3 var(--gs-text,sans-serif)}\n.gs-dish__name{margin:0;font:700 1rem/1.3 var(--gs-text,sans-serif);color:var(--gs7-ink,#20271A)}\n.gs-dish__kcal{margin-top:auto;font:800 1.3125rem/1 var(--gs-display,system-ui,sans-serif);\n  font-variant-numeric:tabular-nums;letter-spacing:-.03em;color:var(--gs7-green,#3F6B39)}\n.gs-dish__kcal small{font:600 .8125rem/1 var(--gs-text,sans-serif);color:var(--gs7-muted,#4E5748);letter-spacing:0}\n.gs-dish__macros{display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:10px 0 0;list-style:none;\n  border-top:1px solid #E3E8DE}\n.gs-dish__macros li{background:var(--gs7-soft,#F4F8EE);border-radius:999px;padding:3px 9px;\n  color:var(--gs7-ink,#20271A);font-variant-numeric:tabular-nums;\n  font:700 12px/1.3 var(--gs-text,sans-serif)}\n.gs-dishes__foot{display:flex;justify-content:center;margin-top:22px}\n@media (max-width:560px){.gs-dishes__foot .gs-btn{width:100%}}\n@media (max-width:767px){.gs-car__nav{display:none}}\n</style>\n<section class=\"gs-sec gs-sec--soft\" id=\"gsDishes\">\n  <div class=\"gs-wrap gs-center\">\n    <h2 class=\"gs-h2\">Меню дня</h2>\n    <p class=\"gs-lead\">Настоящие блюда из меню с точным весом и КБЖУ.</p>\n  </div>\n  <div class=\"gs-car\">\n    <div class=\"gs-car__head\">\n      <span class=\"gs-car__count\">8 из 297 блюд меню</span>\n      <div class=\"gs-car__nav\">\n        <button type=\"button\" class=\"gs-car__btn\" data-gs-car-prev aria-label=\"Предыдущие блюда\"><svg width=\"12\" height=\"18\" viewBox=\"0 0 12 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M10 2L2 10L10 18\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>\n        <button type=\"button\" class=\"gs-car__btn\" data-gs-car-next aria-label=\"Следующие блюда\"><svg width=\"12\" height=\"18\" viewBox=\"0 0 12 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M2 2L10 10L2 18\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>\n      </div>\n    </div>\n    <div class=\"gs-dishes\" data-gs-car role=\"region\" aria-label=\"Блюда из меню\" tabindex=\"0\">\n      <article class=\"gs-dish\">\n        <img class=\"gs-dish__img\" src=\"/meals_uploads/ce50b8a7-f757-46c7-b4a2-89e26c3a4e4d.png\" alt=\"Скрембл с индейкой\" width=\"340\" height=\"250\" decoding=\"async\" fetchpriority=\"high\">\n        <div class=\"gs-dish__body\">\n          <span class=\"gs-dish__cat\">Завтрак</span>\n          <h3 class=\"gs-dish__name\">Скрембл с индейкой</h3>\n          <div class=\"gs-dish__kcal\">355 ккал <small>· 220 г</small></div>\n          <ul class=\"gs-dish__macros\"><li>Б 28</li><li>Ж 24</li><li>У 6</li></ul>\n        </div>\n      </article>\n      <article class=\"gs-dish\">\n        <img class=\"gs-dish__img\" src=\"/meals_uploads/5cbc0d92-4f2b-4dba-b833-afe05b873fef.png\" alt=\"Каша овсяная с фруктами\" width=\"340\" height=\"250\" decoding=\"async\" fetchpriority=\"high\">\n        <div class=\"gs-dish__body\">\n          <span class=\"gs-dish__cat\">Завтрак</span>\n          <h3 class=\"gs-dish__name\">Каша овсяная с фруктами</h3>\n          <div class=\"gs-dish__kcal\">251 ккал <small>· 325 г</small></div>\n          <ul class=\"gs-dish__macros\"><li>Б 5</li><li>Ж 4</li><li>У 49</li></ul>\n        </div>\n      </article>\n      <article class=\"gs-dish\">\n        <img class=\"gs-dish__img\" src=\"/meals_uploads/5780c47b-f840-413a-84e9-353b287fcc8b.png\" alt=\"Суп Минестроне\" width=\"340\" height=\"250\" decoding=\"async\">\n        <div class=\"gs-dish__body\">\n          <span class=\"gs-dish__cat\">Обед</span>\n          <h3 class=\"gs-dish__name\">Суп Минестроне</h3>\n          <div class=\"gs-dish__kcal\">246 ккал <small>· 277 г</small></div>\n          <ul class=\"gs-dish__macros\"><li>Б 17</li><li>Ж 9</li><li>У 24</li></ul>\n        </div>\n      </article>\n      <article class=\"gs-dish\">\n        <img class=\"gs-dish__img\" src=\"/meals_uploads/dd6e64c0-b6b7-4667-b2d3-32456569c82e.png\" alt=\"Куриная грудка с нутом\" width=\"340\" height=\"250\" decoding=\"async\">\n        <div class=\"gs-dish__body\">\n          <span class=\"gs-dish__cat\">Обед</span>\n          <h3 class=\"gs-dish__name\">Куриная грудка с нутом</h3>\n          <div class=\"gs-dish__kcal\">293 ккал <small>· 240 г</small></div>\n          <ul class=\"gs-dish__macros\"><li>Б 27</li><li>Ж 9</li><li>У 26</li></ul>\n        </div>\n      </article>\n      <article class=\"gs-dish\">\n        <img class=\"gs-dish__img\" src=\"/meals_uploads/54902b2e-32e1-4db6-b2a1-eeb4e6a2c1e9.png\" alt=\"Салат Цезарь с курицей\" width=\"340\" height=\"250\" decoding=\"async\">\n        <div class=\"gs-dish__body\">\n          <span class=\"gs-dish__cat\">Полдник</span>\n          <h3 class=\"gs-dish__name\">Салат Цезарь с курицей</h3>\n          <div class=\"gs-dish__kcal\">266 ккал <small>· 165 г</small></div>\n          <ul class=\"gs-dish__macros\"><li>Б 19</li><li>Ж 19</li><li>У 5</li></ul>\n        </div>\n      </article>\n      <article class=\"gs-dish\">\n        <img class=\"gs-dish__img\" src=\"/meals_uploads/7da78f8e-bda5-4da0-ad5f-008f1c8409e8.jpg\" alt=\"Куриная грудка с кускусом ПП\" width=\"340\" height=\"250\" decoding=\"async\">\n        <div class=\"gs-dish__body\">\n          <span class=\"gs-dish__cat\">Ужин</span>\n          <h3 class=\"gs-dish__name\">Куриная грудка с кускусом ПП</h3>\n          <div class=\"gs-dish__kcal\">233 ккал <small>· 327 г</small></div>\n          <ul class=\"gs-dish__macros\"><li>Б 33</li><li>Ж 7</li><li>У 9</li></ul>\n        </div>\n      </article>\n      <article class=\"gs-dish\">\n        <img class=\"gs-dish__img\" src=\"/meals_uploads/1b213d3b-39e3-4ef2-8359-6e7d500acf03.png\" alt=\"Курица с овощами на гриле\" width=\"340\" height=\"250\" decoding=\"async\">\n        <div class=\"gs-dish__body\">\n          <span class=\"gs-dish__cat\">Ужин</span>\n          <h3 class=\"gs-dish__name\">Курица с овощами на гриле</h3>\n          <div class=\"gs-dish__kcal\">218 ккал <small>· 280 г</small></div>\n          <ul class=\"gs-dish__macros\"><li>Б 24</li><li>Ж 9</li><li>У 11</li></ul>\n        </div>\n      </article>\n      <article class=\"gs-dish\">\n        <img class=\"gs-dish__img\" src=\"/meals_uploads/e4271969-4e45-48a3-b10e-ad3b738c583d.png\" alt=\"Куриный кебаб с овощами гриль\" width=\"340\" height=\"250\" decoding=\"async\">\n        <div class=\"gs-dish__body\">\n          <span class=\"gs-dish__cat\">Ужин</span>\n          <h3 class=\"gs-dish__name\">Куриный кебаб с овощами гриль</h3>\n          <div class=\"gs-dish__kcal\">363 ккал <small>· 330 г</small></div>\n          <ul class=\"gs-dish__macros\"><li>Б 28</li><li>Ж 24</li><li>У 10</li></ul>\n        </div>\n      </article>\n    </div>\n  </div>\n  <div class=\"gs-wrap gs-dishes__foot\">\n    <a class=\"gs-btn gs-btn--ghost gs-btn--big\" href=\"#orderFunnel\" data-cta=\"dishes-order\">Собрать рацион</a>\n  </div>\n</section>\n<script>\n(function(){\n  var track=document.querySelector('[data-gs-car]');\n  if(!track)return;\n  var prev=document.querySelector('[data-gs-car-prev]');\n  var next=document.querySelector('[data-gs-car-next]');\n  if(!prev||!next)return;\n  function step(){\n    var card=track.querySelector('.gs-dish');\n    return card?card.getBoundingClientRect().width+14:272;\n  }\n  function go(dir){track.scrollBy({left:dir*step(),behavior:'smooth'});}\n  prev.addEventListener('click',function(){go(-1);});\n  next.addEventListener('click',function(){go(1);});\n  function sync(){\n    var max=track.scrollWidth-track.clientWidth-2;\n    prev.disabled=track.scrollLeft<=2;\n    next.disabled=track.scrollLeft>=max;\n  }\n  track.addEventListener('scroll',sync,{passive:true});\n  window.addEventListener('resize',sync);\n  sync();\n})();\n</script>"
  }
}