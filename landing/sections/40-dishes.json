{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-dishes-css\">\n/* LK round: Level Kitchen's menu panel (levelkitchen.com/spb — .desktop-actual-menu--dark:\n   a dark header carrying the day's nutrition line, then .actual-menu-list cards showing\n   «207 ккал 20 Б 5 Ж 22 У»). Ported onto our six real meals: name / mass / kcal / Б-Ж-У\n   are verbatim from the meals API and are never edited by hand.\n   The header totals are plain arithmetic over exactly those six cards\n   (355+391+233+376+246+168 = 1 769; Б 132, Ж 93, У 98) and are labelled as the sum of the\n   six shown — NOT a day's ration, which would be a fabricated figure.\n   Emoji tiles remain symbolic: the meals API exposes no dish images and stock photos are\n   banned (implementer handoff). Grid replaces the old side-scroller — LK shows the menu\n   as a grid, and a 2-col grid removes the «did I miss a card?» problem on mobile. */\n.gs-menu{max-width:1200px;margin:30px auto 0;padding:0 20px}\n.gs-menu__panel{background:var(--gs7-ink,#20271A);border-radius:var(--gs-r-big,26px);\n  padding:20px 18px;text-align:left}\n.gs-menu__row{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap}\n.gs-menu__title{margin:0;font:800 1.1875rem/1.2 var(--gs-display,system-ui,sans-serif);\n  letter-spacing:-.02em;color:#fff}\n.gs-menu__count{font:700 .8125rem/1.3 var(--gs-text,sans-serif);color:#C3DF9C}\n.gs-menu__nutri{display:flex;flex-wrap:wrap;gap:6px 14px;margin:12px 0 0;padding:0;list-style:none}\n.gs-menu__nutri li{font:600 .875rem/1.3 var(--gs-text,sans-serif);color:#E8EFE0;\n  font-variant-numeric:tabular-nums}\n.gs-menu__nutri li b{font-weight:800;color:#fff}\n.gs-menu__note{margin:10px 0 0;font:500 .8125rem/1.45 var(--gs-text,sans-serif);color:#B9C4AF}\n.gs-dishes{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}\n.gs-dish{background:#fff;border:1px solid #E3E8DE;border-radius:18px;overflow:hidden;\n  display:flex;flex-direction:column;text-align:left}\n.gs-dish .gs-imgbox{aspect-ratio:4/3}\n.gs-dish .gs-imgbox::before{font-size:40px}\n.gs-dish__body{flex:1;display:flex;flex-direction:column;gap:8px;padding:12px 13px 14px}\n.gs-dish__cat{align-self:flex-start;background:var(--gs7-spring,#DCEBC4);color:var(--gs7-deep,#2C4E28);\n  border-radius:999px;padding:3px 9px;text-transform:uppercase;letter-spacing:.04em;\n  font:700 11px/1.3 var(--gs-text,sans-serif)}\n.gs-dish__name{margin:0;font:700 .9375rem/1.3 var(--gs-text,sans-serif);color:var(--gs7-ink,#20271A)}\n.gs-dish__kcal{margin-top:auto;font:800 1.25rem/1 var(--gs-display,system-ui,sans-serif);\n  letter-spacing:-.03em;color:var(--gs7-green,#3F6B39);font-variant-numeric:tabular-nums}\n.gs-dish__kcal small{font:600 .75rem/1 var(--gs-text,sans-serif);color:var(--gs7-muted,#4E5748);letter-spacing:0}\n.gs-dish__macros{display:flex;flex-wrap:wrap;gap:5px;margin:0;padding:10px 0 0;list-style:none;\n  border-top:1px solid #E3E8DE}\n.gs-dish__macros li{background:var(--gs7-soft,#F4F8EE);border-radius:999px;padding:3px 8px;\n  color:var(--gs7-ink,#20271A);font-variant-numeric:tabular-nums;\n  font:700 12px/1.3 var(--gs-text,sans-serif)}\n.gs-dishes__foot{display:flex;justify-content:center;margin-top:24px}\n@media (max-width:560px){.gs-dishes__foot .gs-btn{width:100%}}\n@media (min-width:768px){\n  .gs-dishes{grid-template-columns:repeat(3,1fr);gap:16px}\n  .gs-menu__panel{padding:26px 28px}\n  .gs-menu__title{font-size:1.5rem}}\n</style>\n<section class=\"gs-sec gs-sec--soft\" id=\"gsDishes\">\n  <div class=\"gs-wrap gs-center\">\n    <h2 class=\"gs-h2 gs-reveal\">Что внутри рациона</h2>\n    <p class=\"gs-lead gs-reveal gs-reveal--d1\">Реальные блюда из меню O-live — вес и КБЖУ как в рационе. Все шесть входят в планы 1&nbsp;200 и 1&nbsp;500 ккал.</p>\n  </div>\n  <div class=\"gs-menu\">\n    <div class=\"gs-menu__panel gs-reveal\">\n      <div class=\"gs-menu__row\">\n        <h3 class=\"gs-menu__title\">Примеры блюд</h3>\n        <span class=\"gs-menu__count\">6 из 297 блюд меню</span>\n      </div>\n      <ul class=\"gs-menu__nutri\">\n        <li><b>1 769</b> ккал</li><li><b>132</b> белки</li><li><b>93</b> жиры</li><li><b>98</b> углеводы</li>\n      </ul>\n      <p class=\"gs-menu__note\">Сумма шести блюд ниже, а не дневная норма: состав дня зависит от выбранной калорийности.</p>\n    </div>\n    <div class=\"gs-dishes\">\n      <article class=\"gs-dish gs-reveal\"><div class=\"gs-imgbox\" data-emoji=\"🍳\" aria-hidden=\"true\"></div><div class=\"gs-dish__body\">\n        <span class=\"gs-dish__cat\">Завтрак</span>\n        <h4 class=\"gs-dish__name\">Скрембл с индейкой</h4>\n        <div class=\"gs-dish__kcal\">355 ккал <small>· 220 г</small></div>\n        <ul class=\"gs-dish__macros\"><li>Б 28</li><li>Ж 24</li><li>У 6</li></ul>\n      </div></article>\n      <article class=\"gs-dish gs-reveal gs-reveal--d1\"><div class=\"gs-imgbox\" data-emoji=\"🥞\" aria-hidden=\"true\"></div><div class=\"gs-dish__body\">\n        <span class=\"gs-dish__cat\">Завтрак</span>\n        <h4 class=\"gs-dish__name\">Сырники с чиа</h4>\n        <div class=\"gs-dish__kcal\">391 ккал <small>· 185 г</small></div>\n        <ul class=\"gs-dish__macros\"><li>Б 20</li><li>Ж 18</li><li>У 37</li></ul>\n      </div></article>\n      <article class=\"gs-dish gs-reveal gs-reveal--d2\"><div class=\"gs-imgbox\" data-emoji=\"🍗\" aria-hidden=\"true\"></div><div class=\"gs-dish__body\">\n        <span class=\"gs-dish__cat\">Второе</span>\n        <h4 class=\"gs-dish__name\">Куриная грудка с кускусом ПП</h4>\n        <div class=\"gs-dish__kcal\">233 ккал <small>· 327 г</small></div>\n        <ul class=\"gs-dish__macros\"><li>Б 33</li><li>Ж 7</li><li>У 9</li></ul>\n      </div></article>\n      <article class=\"gs-dish gs-reveal\"><div class=\"gs-imgbox\" data-emoji=\"🐟\" aria-hidden=\"true\"></div><div class=\"gs-dish__body\">\n        <span class=\"gs-dish__cat\">Второе</span>\n        <h4 class=\"gs-dish__name\">Нежная семга с овощами гриль</h4>\n        <div class=\"gs-dish__kcal\">376 ккал <small>· 305 г</small></div>\n        <ul class=\"gs-dish__macros\"><li>Б 25</li><li>Ж 25</li><li>У 11</li></ul>\n      </div></article>\n      <article class=\"gs-dish gs-reveal gs-reveal--d1\"><div class=\"gs-imgbox\" data-emoji=\"🍲\" aria-hidden=\"true\"></div><div class=\"gs-dish__body\">\n        <span class=\"gs-dish__cat\">Суп</span>\n        <h4 class=\"gs-dish__name\">Суп Минестроне</h4>\n        <div class=\"gs-dish__kcal\">246 ккал <small>· 277 г</small></div>\n        <ul class=\"gs-dish__macros\"><li>Б 17</li><li>Ж 9</li><li>У 24</li></ul>\n      </div></article>\n      <article class=\"gs-dish gs-reveal gs-reveal--d2\"><div class=\"gs-imgbox\" data-emoji=\"🍫\" aria-hidden=\"true\"></div><div class=\"gs-dish__body\">\n        <span class=\"gs-dish__cat\">Десерт</span>\n        <h4 class=\"gs-dish__name\">Брауни без сахара</h4>\n        <div class=\"gs-dish__kcal\">168 ккал <small>· 45 г</small></div>\n        <ul class=\"gs-dish__macros\"><li>Б 9</li><li>Ж 10</li><li>У 11</li></ul>\n      </div></article>\n    </div>\n  </div>\n  <div class=\"gs-wrap gs-dishes__foot gs-reveal\">\n    <a class=\"gs-btn gs-btn--ghost gs-btn--big\" href=\"#orderFunnel\" data-cta=\"dishes-order\">Собрать рацион</a>\n  </div>\n</section>"
  }
}