{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-cals-css\">\n/* v7 skin: donor calorie grid (research/donor-v7.html:221-239) on real plan data.\n   Plans + dishes/day verified against pricing matrix and 60-faq item 5; «42% заказов»\n   is the real 1200-kcal order share (BRIEF §4: 474/1130). Cards are anchors into the\n   funnel, not fake toggles. Uses 04-skin primitives (.gs-sec/.gs-h2/.gs-imgbox/...). */\n.gs-cals{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:30px}\n.gs-cal{position:relative;display:block;background:#fff;border:2px solid var(--gs7-line,rgba(32,39,26,.12));\n  border-radius:var(--gs-r-card,22px);overflow:hidden;text-align:left;text-decoration:none;\n  box-shadow:var(--gs-sh-card,0 14px 30px -18px rgba(32,39,26,.22));transition:border-color .15s}\n.gs-cal:hover,.gs-cal:focus-visible{border-color:var(--gs7-green,#3F6B39)}\n.gs-cal:active{transform:scale(.99)}\n.gs-cal .gs-imgbox{aspect-ratio:16/11}\n.gs-cal .gs-imgbox::before{font-size:56px}\n.gs-cal__flag{position:absolute;top:10px;left:10px;z-index:1;background:var(--gs7-green,#3F6B39);\n  color:#fff;font:800 var(--gs-fs-xs,.75rem)/1.3 var(--gs-text,sans-serif);\n  padding:5px 11px;border-radius:999px}\n.gs-cal__b{padding:16px 18px}\n.gs-cal__kc{font:800 1.75rem/1 var(--gs-display,system-ui,sans-serif);letter-spacing:-.04em;\n  color:var(--gs7-ink,#20271A);font-variant-numeric:tabular-nums}\n.gs-cal__kc small{font:700 .875rem/1 var(--gs-text,sans-serif);color:var(--gs7-green,#3F6B39);letter-spacing:0}\n.gs-cal__di{margin-top:2px;font:600 var(--gs-fs-sm,.875rem)/1.4 var(--gs-text,sans-serif);\n  color:var(--gs7-muted,#697260)}\n.gs-cals__price{text-align:center;margin-top:28px}\n.gs-cals__price .gs-cals__p{font:800 clamp(1.625rem,6vw,2.5rem)/1.1 var(--gs-display,system-ui,sans-serif);\n  letter-spacing:-.04em;color:var(--gs7-green,#3F6B39);font-variant-numeric:tabular-nums}\n.gs-cals__price .gs-cals__n{margin-top:6px;font:600 var(--gs-fs-sm,.875rem)/1.45 var(--gs-text,sans-serif);\n  color:var(--gs7-muted,#697260);max-width:44ch;margin-left:auto;margin-right:auto}\n@media (min-width:768px){.gs-cals{grid-template-columns:repeat(4,1fr)}}\n@media (prefers-reduced-motion:reduce){.gs-cal{transition:none}.gs-cal:active{transform:none}}\n</style>\n<section class=\"gs-sec\" id=\"gsCals\">\n  <div class=\"gs-wrap gs-center\">\n    <h2 class=\"gs-h2\">Под вашу калорийность</h2>\n    <p class=\"gs-lead\">1 200 и 1 500 ккал — снижение веса, 1 800 — баланс, 2 500 — набор массы.</p>\n    <div class=\"gs-cals\">\n      <a class=\"gs-cal\" href=\"#orderFunnel\" data-cta=\"cal-1200\">\n        <span class=\"gs-cal__flag\">42% заказов</span>\n        <div class=\"gs-imgbox\" data-emoji=\"🥙\" aria-hidden=\"true\"></div>\n        <div class=\"gs-cal__b\"><div class=\"gs-cal__kc\">1200 <small>ккал</small></div>\n        <div class=\"gs-cal__di\">4 блюда в день</div></div>\n      </a>\n      <a class=\"gs-cal\" href=\"#orderFunnel\" data-cta=\"cal-1500\">\n        <div class=\"gs-imgbox\" data-emoji=\"🍲\" aria-hidden=\"true\"></div>\n        <div class=\"gs-cal__b\"><div class=\"gs-cal__kc\">1500 <small>ккал</small></div>\n        <div class=\"gs-cal__di\">4 блюда в день</div></div>\n      </a>\n      <a class=\"gs-cal\" href=\"#orderFunnel\" data-cta=\"cal-1800\">\n        <div class=\"gs-imgbox\" data-emoji=\"🍛\" aria-hidden=\"true\"></div>\n        <div class=\"gs-cal__b\"><div class=\"gs-cal__kc\">1800 <small>ккал</small></div>\n        <div class=\"gs-cal__di\">5 блюд в день</div></div>\n      </a>\n      <a class=\"gs-cal\" href=\"#orderFunnel\" data-cta=\"cal-2500\">\n        <div class=\"gs-imgbox\" data-emoji=\"🥩\" aria-hidden=\"true\"></div>\n        <div class=\"gs-cal__b\"><div class=\"gs-cal__kc\">2500 <small>ккал</small></div>\n        <div class=\"gs-cal__di\">6 блюд в день</div></div>\n      </a>\n    </div>\n    <div class=\"gs-cals__price\">\n      <div class=\"gs-cals__p\">День еды — от 5 000 ₸</div>\n      <div class=\"gs-cals__n\">на тарифах 14 и 30 дней с учётом подарочных; в Алматы есть зона бесплатной доставки</div>\n    </div>\n  </div>\n</section>"
  }
}
