{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-hero-css\">\n/* v7 skin (design/SKIN_V7.md): donor hero, research/donor-v7.html:61-73.\n   Headline is a <p>: the page's single <h1> belongs to the funnel (qa.py rule). */\n.gs-hero{position:relative;overflow:hidden;background:#fff;padding:36px 0 44px;text-align:center}\n.gs-hero__arc{position:absolute;top:-46%;left:50%;transform:translateX(-50%);width:150%;height:82%;\n  background:linear-gradient(180deg,#DCEBC4,rgba(220,235,196,0));border-radius:0 0 50% 50%;\n  opacity:.8;pointer-events:none}\n.gs-hero__in{position:relative;max-width:1200px;margin:0 auto;padding:0 20px}\n.gs-hero__h{margin:0;font:800 clamp(3.25rem,15vw,6.75rem)/0.96 var(--gs-display,system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  letter-spacing:-.045em;color:#20271A}\n.gs-hero__bowl{position:relative;width:min(62%,340px);margin:18px auto 0;aspect-ratio:1;border-radius:50%;\n  background:url(\"/assets/images/banner-menu-food.webp\") center/cover no-repeat,\n    linear-gradient(140deg,#DCEBC4,#C3DF9C);\n  box-shadow:0 30px 60px -30px rgba(32,39,26,.35)}\n.gs-hero__sub{margin:22px auto 24px;max-width:30ch;font:500 clamp(1rem,4vw,1.25rem)/1.5 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);color:#697260}\n.gs-hero__cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}\n.gs-hero__btn{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:17px 34px;\n  border-radius:999px;background:#3F6B39;color:#fff;text-decoration:none;\n  font:700 1.0625rem/1.05 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  box-shadow:0 12px 24px -12px #2C4E28;transition:background .15s}\n.gs-hero__btn:hover,.gs-hero__btn:focus{background:#4E8046;color:#fff}\n.gs-hero__btn--ghost{background:transparent;color:#3F6B39;border:1.5px solid #3F6B39;box-shadow:none}\n.gs-hero__btn--ghost:hover,.gs-hero__btn--ghost:focus{background:#F4F8EE;color:#2C4E28}\n@keyframes gs-rise{to{opacity:1;transform:none}}\n.gs-hero__h,.gs-hero__bowl,.gs-hero__sub,.gs-hero__cta{opacity:0;transform:translateY(22px);\n  animation:gs-rise .9s cubic-bezier(.2,.8,.2,1) forwards}\n.gs-hero__bowl{animation-delay:.12s}.gs-hero__sub{animation-delay:.24s}.gs-hero__cta{animation-delay:.34s}\n@media (prefers-reduced-motion:reduce){\n  .gs-hero__h,.gs-hero__bowl,.gs-hero__sub,.gs-hero__cta{animation:none;opacity:1;transform:none}\n  .gs-hero__btn{transition:none}}\n@media (min-width:1024px){.gs-hero{padding:48px 0 74px}.gs-hero__bowl{width:min(42%,440px)}}\n</style>\n<section class=\"gs-hero\">\n  <div class=\"gs-hero__arc\" aria-hidden=\"true\"></div>\n  <div class=\"gs-hero__in\">\n    <p class=\"gs-hero__h\">Питайся<br>здорово</p>\n    <div class=\"gs-hero__bowl\" role=\"img\" aria-label=\"Рацион O-live\"></div>\n    <p class=\"gs-hero__sub\">Рационы для снижения веса и баланса — с доставкой по Алматы каждый день.</p>\n    <div class=\"gs-hero__cta\">\n      <a class=\"gs-hero__btn\" href=\"#orderFunnel\" data-cta=\"hero\">Заказать</a>\n      <a class=\"gs-hero__btn gs-hero__btn--ghost\" href=\"#gsDishes\" data-cta=\"hero-menu\">Смотреть блюда</a>\n    </div>\n  </div>\n</section>"
  }
}
