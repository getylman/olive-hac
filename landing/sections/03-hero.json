{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-hero-css\">\n/* Hero — 21st.dev AnimatedMarqueeHero (hero.txt) ported to plain CSS: tagline pill,\n   word-staggered title, description, CTA, and a looping photo marquee at the bottom.\n   framer-motion variants become keyframes; the duplicated image array becomes a track\n   duplicated in markup and translated -50% -> 0 for a seamless loop.\n   Headline stays a <p>: the page's single <h1> belongs to the funnel (qa.py rule).\n   Photos are Olive's own assets, root-relative (same-origin; validate.py counts only\n   absolute/protocol-relative as external), each curl-verified 200 on 2026-08-16.\n   banner-menu-food.webp is 1204x351 (a dish spread) so three background-position\n   slices give three distinct tiles; every tile has a gradient under the image, so a\n   failed load degrades to the spring wash with no broken-image glyph. */\n/* top padding clears the site's fixed .sf-header — measured 49.75px at 390px on the\n   live render (v1331); without it the tagline pill sits behind the chrome */\n.gs-hero{position:relative;overflow:hidden;background:#fff;padding:68px 0 0;text-align:center}\n.gs-hero__arc{position:absolute;top:-46%;left:50%;transform:translateX(-50%);width:150%;height:76%;\n  background:linear-gradient(180deg,#DCEBC4,rgba(220,235,196,0));border-radius:0 0 50% 50%;\n  opacity:.85;pointer-events:none}\n.gs-hero__in{position:relative;max-width:1200px;margin:0 auto;padding:0 20px}\n.gs-hero__tag{display:inline-block;margin:0 0 18px;padding:8px 16px;border-radius:999px;\n  border:1px solid rgba(32,39,26,.16);background:rgba(255,255,255,.6);\n  -webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);\n  font:700 .8125rem/1.35 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  color:var(--gs7-deep,#2C4E28);max-width:34ch}\n.gs-hero__h{margin:0;font:800 clamp(3.5rem,16vw,7rem)/0.94 var(--gs-display,system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  letter-spacing:-.05em;color:var(--gs7-ink,#20271A);text-wrap:balance}\n.gs-hero__w{display:inline-block}\n.gs-hero__sub{margin:20px auto 26px;max-width:26ch;\n  font:500 clamp(1.0625rem,4.4vw,1.375rem)/1.45 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  color:var(--gs7-muted,#4E5748)}\n.gs-hero__cta{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;max-width:420px;margin:0 auto}\n/* both CTAs share one row on a 390px viewport (flex:1 with min-width:0) instead of\n   stacking — the stacked pair pushed the offer a further ~70px below the fold */\n.gs-hero__btn{flex:1 1 0;min-width:0;display:inline-flex;align-items:center;justify-content:center;min-height:58px;padding:18px 12px;\n  border-radius:999px;background:var(--gs7-green,#3F6B39);color:#fff;text-decoration:none;\n  font:700 1.0625rem/1.05 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  box-shadow:0 14px 28px -14px var(--gs7-deep,#2C4E28);transition:background .15s,transform .15s}\n.gs-hero__btn:hover,.gs-hero__btn:focus{background:var(--gs7-green2,#4E8046);color:#fff}\n.gs-hero__btn:active{transform:scale(.97)}\n.gs-hero__btn--ghost{background:transparent;color:var(--gs7-green,#3F6B39);\n  border:1.5px solid var(--gs7-green,#3F6B39);box-shadow:none}\n.gs-hero__btn--ghost:hover,.gs-hero__btn--ghost:focus{background:var(--gs7-soft,#F4F8EE);color:var(--gs7-deep,#2C4E28)}\n\n/* --- photo marquee --- */\n.gs-hero__marquee{position:relative;margin-top:34px;overflow:hidden;padding:14px 0 22px;\n  -webkit-mask-image:linear-gradient(to right,transparent,#000 7%,#000 93%,transparent);\n  mask-image:linear-gradient(to right,transparent,#000 7%,#000 93%,transparent)}\n.gs-hero__track{display:flex;gap:14px;width:max-content;animation:gs-marq 40s linear infinite}\n.gs-hero__tile{flex:0 0 auto;width:132px;aspect-ratio:3/4;border-radius:18px;overflow:hidden;\n  background-color:#DCEBC4;background-image:linear-gradient(140deg,rgba(220,235,196,0),rgba(195,223,156,.6));\n  box-shadow:0 16px 32px -20px rgba(32,39,26,.5)}\n.gs-hero__tile:nth-child(odd){transform:rotate(-2deg)}\n.gs-hero__tile:nth-child(even){transform:rotate(5deg)}\n.gs-hero__tile--a{background-image:url(\"/assets/images/banner-menu-food.webp\"),linear-gradient(140deg,#DCEBC4,#C3DF9C);background-size:auto 100%,cover;background-position:0% center,center;background-repeat:no-repeat}\n.gs-hero__tile--b{background-image:url(\"/assets/images/quality/1.webp\"),linear-gradient(140deg,#DCEBC4,#C3DF9C);background-size:cover,cover;background-position:center,center;background-repeat:no-repeat}\n.gs-hero__tile--c{background-image:url(\"/assets/images/promo-food.webp\"),linear-gradient(140deg,#DCEBC4,#C3DF9C);background-size:cover,cover;background-position:center,center;background-repeat:no-repeat}\n.gs-hero__tile--d{background-image:url(\"/assets/images/banner-menu-food.webp\"),linear-gradient(140deg,#DCEBC4,#C3DF9C);background-size:auto 100%,cover;background-position:38% center,center;background-repeat:no-repeat}\n.gs-hero__tile--e{background-image:url(\"/assets/images/quality/2.webp\"),linear-gradient(140deg,#DCEBC4,#C3DF9C);background-size:cover,cover;background-position:center,center;background-repeat:no-repeat}\n.gs-hero__tile--f{background-image:url(\"/assets/images/form.webp\"),linear-gradient(140deg,#DCEBC4,#C3DF9C);background-size:auto 130%,cover;background-position:2% center,center;background-repeat:no-repeat}\n.gs-hero__tile--g{background-image:url(\"/assets/images/banner-menu-food.webp\"),linear-gradient(140deg,#DCEBC4,#C3DF9C);background-size:auto 100%,cover;background-position:76% center,center;background-repeat:no-repeat}\n.gs-hero__tile--h{background-image:url(\"/assets/images/quality/3.webp\"),linear-gradient(140deg,#DCEBC4,#C3DF9C);background-size:cover,cover;background-position:center,center;background-repeat:no-repeat}\n@keyframes gs-marq{from{transform:translateX(-50%)}to{transform:translateX(0)}}\n\n/* --- entrance (framer-motion FADE_IN_ANIMATION_VARIANTS: y 10 -> 0, spring-ish) --- */\n@keyframes gs-rise{to{opacity:1;transform:none}}\n.gs-hero__tag,.gs-hero__w,.gs-hero__sub,.gs-hero__cta,.gs-hero__marquee{opacity:0;\n  transform:translateY(16px);animation:gs-rise .75s cubic-bezier(.2,.8,.2,1) forwards}\n.gs-hero__w:nth-child(1){animation-delay:.10s}\n.gs-hero__w:nth-child(2){animation-delay:.20s}\n.gs-hero__w:nth-child(3){animation-delay:.30s}\n.gs-hero__sub{animation-delay:.42s}\n.gs-hero__cta{animation-delay:.52s}\n.gs-hero__marquee{animation-delay:.60s}\n@media (prefers-reduced-motion:reduce){\n  .gs-hero__tag,.gs-hero__w,.gs-hero__sub,.gs-hero__cta,.gs-hero__marquee{animation:none;opacity:1;transform:none}\n  .gs-hero__track{animation:none}\n  .gs-hero__btn{transition:none}}\n@media (min-width:768px){\n  .gs-hero{padding:84px 0 0}\n  .gs-hero__tile{width:184px}\n  .gs-hero__marquee{margin-top:44px;padding:18px 0 30px}}\n</style>\n<section class=\"gs-hero\">\n  <div class=\"gs-hero__arc\" aria-hidden=\"true\"></div>\n  <div class=\"gs-hero__in\">\n    <p class=\"gs-hero__tag\">Нужный КБЖУ каждый день с доставкой по Алматы</p>\n    <p class=\"gs-hero__h\"><span class=\"gs-hero__w\">Питайся</span> <span class=\"gs-hero__w\">здорово</span></p>\n    <p class=\"gs-hero__sub\">Готовые рационы от 1&nbsp;200 до 2&nbsp;500 ккал.</p>\n    <div class=\"gs-hero__cta\">\n      <a class=\"gs-hero__btn\" href=\"#orderFunnel\" data-cta=\"hero\">Собрать рацион</a>\n      <a class=\"gs-hero__btn gs-hero__btn--ghost\" href=\"#gsDishes\" data-cta=\"hero-menu\">Смотреть меню</a>\n    </div>\n  </div>\n  <div class=\"gs-hero__marquee\" aria-hidden=\"true\">\n    <div class=\"gs-hero__track\">\n      <div class=\"gs-hero__tile gs-hero__tile--a\"></div><div class=\"gs-hero__tile gs-hero__tile--b\"></div>\n      <div class=\"gs-hero__tile gs-hero__tile--c\"></div><div class=\"gs-hero__tile gs-hero__tile--d\"></div>\n      <div class=\"gs-hero__tile gs-hero__tile--e\"></div><div class=\"gs-hero__tile gs-hero__tile--f\"></div>\n      <div class=\"gs-hero__tile gs-hero__tile--g\"></div><div class=\"gs-hero__tile gs-hero__tile--h\"></div>\n      <div class=\"gs-hero__tile gs-hero__tile--a\"></div><div class=\"gs-hero__tile gs-hero__tile--b\"></div>\n      <div class=\"gs-hero__tile gs-hero__tile--c\"></div><div class=\"gs-hero__tile gs-hero__tile--d\"></div>\n      <div class=\"gs-hero__tile gs-hero__tile--e\"></div><div class=\"gs-hero__tile gs-hero__tile--f\"></div>\n      <div class=\"gs-hero__tile gs-hero__tile--g\"></div><div class=\"gs-hero__tile gs-hero__tile--h\"></div>\n    </div>\n  </div>\n</section>"
  }
}