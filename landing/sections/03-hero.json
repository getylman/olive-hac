{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-hero-css\">\n/* Hero — the 21st.dev AnimatedMarqueeHero layout (hero.txt) with the motion removed at the\n   user's request: tagline pill, headline, one short line of copy, two CTAs, then a photo\n   strip. The strip no longer auto-scrolls and the tiles are no longer rotated; they are one\n   uniform 4:3 size and the strip is swipeable (scroll-snap).\n   Photos are Olive's own assets, root-relative (same-origin; validate.py counts only\n   absolute/protocol-relative as external), each curl-verified 200 on 2026-08-16, and they\n   are real <img> with width/height so the browser's preload scanner starts them with the\n   HTML instead of after the CSS — CSS background-images cannot be discovered that early.\n   banner-menu-food.webp is a 1204x351 dish spread, so three object-position slices give\n   three distinct tiles. alt=\"\" keeps a failed load silent (no broken-image glyph) and the\n   tile's wash shows through. */\n.gs-hero{position:relative;overflow:hidden;background:#fff;padding:68px 0 0;text-align:center}\n.gs-hero__arc{position:absolute;top:-46%;left:50%;transform:translateX(-50%);width:150%;height:76%;\n  background:linear-gradient(180deg,#DCEBC4,rgba(220,235,196,0));border-radius:0 0 50% 50%;\n  opacity:.85;pointer-events:none}\n.gs-hero__in{position:relative;max-width:1200px;margin:0 auto;padding:0 20px}\n.gs-hero__tag{display:inline-block;margin:0 0 18px;padding:9px 16px;border-radius:999px;\n  border:1px solid rgba(32,39,26,.16);background:rgba(255,255,255,.65);\n  font:700 .8125rem/1.35 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  color:var(--gs7-deep,#2C4E28);max-width:34ch}\n.gs-hero__h{margin:0;font:800 clamp(3.25rem,15vw,6.5rem)/0.95 var(--gs-display,system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  letter-spacing:-.05em;color:var(--gs7-ink,#20271A);text-wrap:balance}\n.gs-hero__sub{margin:18px auto 24px;max-width:24ch;\n  font:500 clamp(1.0625rem,4.4vw,1.375rem)/1.45 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  color:var(--gs7-muted,#4E5748)}\n.gs-hero__cta{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;max-width:420px;margin:0 auto}\n.gs-hero__btn{flex:1 1 0;min-width:0;display:inline-flex;align-items:center;justify-content:center;\n  min-height:58px;padding:18px 12px;border-radius:999px;background:var(--gs7-green,#3F6B39);\n  color:#fff;text-decoration:none;\n  font:700 1.0625rem/1.05 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  box-shadow:0 14px 28px -14px var(--gs7-deep,#2C4E28)}\n.gs-hero__btn:hover,.gs-hero__btn:focus{background:var(--gs7-green2,#4E8046);color:#fff}\n.gs-hero__btn--ghost{background:transparent;color:var(--gs7-green,#3F6B39);\n  border:1.5px solid var(--gs7-green,#3F6B39);box-shadow:none}\n.gs-hero__btn--ghost:hover,.gs-hero__btn--ghost:focus{background:var(--gs7-soft,#F4F8EE);color:var(--gs7-deep,#2C4E28)}\n.gs-hero__strip{display:flex;gap:12px;margin-top:32px;padding:0 20px 24px;overflow-x:auto;\n  overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;\n  scroll-snap-type:x mandatory;scroll-padding-left:20px}\n.gs-hero__tile{flex:0 0 auto;width:168px;aspect-ratio:4/3;border-radius:18px;overflow:hidden;\n  background:linear-gradient(140deg,#DCEBC4,#C3DF9C);scroll-snap-align:start;\n  box-shadow:0 16px 32px -22px rgba(32,39,26,.5)}\n.gs-hero__tile img{display:block;width:100%;height:100%;object-fit:cover}\n.gs-hero__tile img.gs-hero__crop--l{object-position:0% center}\n.gs-hero__tile img.gs-hero__crop--c{object-position:50% center}\n.gs-hero__tile img.gs-hero__crop--r{object-position:100% center}\n@media (min-width:768px){\n  .gs-hero{padding:84px 0 0}\n  .gs-hero__strip{justify-content:center;flex-wrap:wrap;overflow:visible}\n  .gs-hero__tile{width:224px}}\n</style>\n<section class=\"gs-hero\">\n  <div class=\"gs-hero__arc\" aria-hidden=\"true\"></div>\n  <div class=\"gs-hero__in\">\n    <p class=\"gs-hero__tag\">Нужный КБЖУ каждый день с доставкой по Алматы</p>\n    <p class=\"gs-hero__h\">Питайся здорово</p>\n    <p class=\"gs-hero__sub\">Готовые рационы от 1&nbsp;200 до 2&nbsp;500 ккал.</p>\n    <div class=\"gs-hero__cta\">\n      <a class=\"gs-hero__btn\" href=\"#orderFunnel\" data-cta=\"hero\">Собрать рацион</a>\n      <a class=\"gs-hero__btn gs-hero__btn--ghost\" href=\"#gsDishes\" data-cta=\"hero-menu\">Смотреть меню</a>\n    </div>\n  </div>\n  <div class=\"gs-hero__strip\" aria-hidden=\"true\">\n    <div class=\"gs-hero__tile\"><img class=\"gs-hero__crop--l\" src=\"/assets/images/banner-menu-food.webp\" alt=\"\" width=\"168\" height=\"126\" fetchpriority=\"high\" decoding=\"async\"></div>\n    <div class=\"gs-hero__tile\"><img src=\"/assets/images/quality/1.webp\" alt=\"\" width=\"168\" height=\"126\" fetchpriority=\"high\" decoding=\"async\"></div>\n    <div class=\"gs-hero__tile\"><img src=\"/assets/images/promo-food.webp\" alt=\"\" width=\"168\" height=\"126\" fetchpriority=\"high\" decoding=\"async\"></div>\n    <div class=\"gs-hero__tile\"><img class=\"gs-hero__crop--c\" src=\"/assets/images/banner-menu-food.webp\" alt=\"\" width=\"168\" height=\"126\" decoding=\"async\"></div>\n    <div class=\"gs-hero__tile\"><img src=\"/assets/images/quality/2.webp\" alt=\"\" width=\"168\" height=\"126\" decoding=\"async\"></div>\n    <div class=\"gs-hero__tile\"><img class=\"gs-hero__crop--r\" src=\"/assets/images/banner-menu-food.webp\" alt=\"\" width=\"168\" height=\"126\" decoding=\"async\"></div>\n    <div class=\"gs-hero__tile\"><img src=\"/assets/images/quality/3.webp\" alt=\"\" width=\"168\" height=\"126\" decoding=\"async\"></div>\n  </div>\n</section>"
  }
}