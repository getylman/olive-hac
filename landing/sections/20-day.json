  "type": "html",
  "props": {
    "content": "<style class=\"gs-day-css\">\n/* «Один день с Olive»: таймлайн одного реального дня на рационе 1 200 ккал.\n   Откуда цифры и почему в тексте нет даты, смотри в комментарии внутри секции.\n   Линия таймлайна нарисована фоновым градиентом на ol, а не псевдоэлементом: рендер\n   псевдоэлемента требует объявления, разрешенного только в полосе 09-pseudo (решение W4).\n   Геометрия: у ol отступ слева 26px, линия 2px стоит на x=7px его паддинг-бокса,\n   точка 14px центрируется на ней при left:-25px внутри каждого li.\n   Пути картинок корневые (/meals_uploads/...): validate.py запрещает абсолютные адреса\n   в src. Атрибуты width/height и мягкий фон на .gs-day__img держат плитку чистой, если\n   файл когда-нибудь пропадет из-за ротации меню.\n   Контраст (WARM_ROUND 1, посчитан 2026-08-16): ink #20271A на белой карточке 15.37;\n   muted #4E5748 на белой карточке 7.55; чип deep #2C4E28 на spring #DCEBC4 7.51;\n   время spring на deep 7.51; белый текст на deep 9.43; точка green #3F6B39 на spring\n   4.96 (нетекстовая метка, порог 3:1); золото #E0A73C на deep 4.38, только декор и\n   aria-hidden, это весь бюджет золота раунда; чип итога deep на белом 9.43;\n   кнопка: белый на green 6.22. Движения в блоке нет по требованию пользователя. */\n.gs-day{background:linear-gradient(180deg,var(--gs7-spring,#DCEBC4) 0,var(--gs7-spring,#DCEBC4) calc(100% - 96px),var(--gs7-soft,#F4F8EE) 100%)}\n.gs-day__line{list-style:none;margin:28px 0 0;padding:0 0 0 26px;display:flex;flex-direction:column;gap:14px;\n  background:linear-gradient(rgba(44,78,40,.28),rgba(44,78,40,.28)) 7px 0/2px 100% no-repeat}\n.gs-day__stop{position:relative}\n.gs-day__dot{position:absolute;left:-25px;top:22px;width:14px;height:14px;border-radius:50%;\n  background:var(--gs7-green,#3F6B39);box-shadow:0 0 0 3px rgba(255,255,255,.85)}\n.gs-day__card{background:#fff;border-radius:var(--gs-r-card,22px);border:1px solid rgba(32,39,26,.08);\n  box-shadow:var(--gs-sh-card,0 14px 30px -18px rgba(32,39,26,.22));display:flex;gap:12px;padding:12px;align-items:center}\n.gs-day__img{width:96px;height:71px;border-radius:12px;object-fit:cover;flex:0 0 auto;background:var(--gs7-soft,#F4F8EE)}\n.gs-day__body{display:flex;flex-direction:column;gap:4px;min-width:0}\n.gs-day__meal{align-self:flex-start;background:var(--gs7-spring,#DCEBC4);color:var(--gs7-deep,#2C4E28);\n  border-radius:999px;padding:3px 10px;text-transform:uppercase;letter-spacing:.04em;font:700 11px/1.3 var(--gs-text,sans-serif)}\n.gs-day__name{margin:0;font:700 1rem/1.3 var(--gs-text,sans-serif);color:var(--gs7-ink,#20271A)}\n.gs-day__facts{margin:0;font:600 .8125rem/1.4 var(--gs-text,sans-serif);color:var(--gs7-muted,#4E5748);font-variant-numeric:tabular-nums}\n.gs-day__card--start{background:var(--gs7-deep,#2C4E28);flex-direction:column;align-items:flex-start;gap:6px;padding:16px}\n.gs-day__time{display:inline-flex;align-items:center;gap:8px;color:var(--gs7-spring,#DCEBC4);\n  font:800 .9375rem/1.3 var(--gs-display,system-ui,sans-serif)}\n.gs-day__spark{color:var(--gs7-gold,#E0A73C);font-size:12px}\n.gs-day__text{margin:0;color:#fff;font:500 .9375rem/1.5 var(--gs-text,sans-serif)}\n.gs-day__total{display:flex;flex-direction:column;gap:14px;align-items:center;margin-top:26px}\n.gs-day__sum{background:#fff;border-radius:999px;padding:10px 18px;color:var(--gs7-deep,#2C4E28);\n  font:800 1.0625rem/1.3 var(--gs-display,system-ui,sans-serif);font-variant-numeric:tabular-nums;\n  box-shadow:var(--gs-sh-card,0 14px 30px -18px rgba(32,39,26,.22))}\n@media (max-width:560px){.gs-day__total .gs-btn{width:100%}}\n@media (min-width:900px){\n  .gs-day__line{margin:28px auto 0}\n  .gs-day__line,.gs-day__total{max-width:640px}\n  .gs-day__total{margin-left:auto;margin-right:auto}\n  .gs-day__img{width:116px;height:85px}}\n</style>\n<section class=\"gs-sec gs-day\" id=\"gsDay\">\n  <!-- Данные: план 5 (1 200 ккал), день 2026-08-20, research/WARM_DATA.md.\n       Перепроверено вживую 2026-08-16 запросом GET /api/meal-plans/5/day/2026-08-20:\n       названия, масса, ккал и файлы картинок совпадают дословно, а поле total_kcal\n       того же ответа равно 1237. Сумма дня: 459+318+97+363 = 1237.\n       Б/Ж/У взяты из дампа meals (297 блюд); для кесадильи и куриной грудинки те же\n       цифры отдает /api/day-meals/ID/replacements.\n       Даты в видимом тексте нет: дневное меню ротируется, а «реальное меню одного дня»\n       остается правдой всегда. Времена доставки только реальные, это два слота фаннела\n       (data-start и data-end): с 6:00 до 9:00 и с 20:00 до 22:00. -->\n  <div class=\"gs-wrap\">\n    <div class=\"gs-center\">\n      <h2 class=\"gs-h2\">Один день с Olive</h2>\n      <p class=\"gs-lead\">Так выглядит день на рационе 1&nbsp;200&nbsp;ккал. Настоящее меню, вес и КБЖУ у каждого блюда.</p>\n    </div>\n    <ol class=\"gs-day__line\" role=\"list\">\n      <li class=\"gs-day__stop\">\n        <span class=\"gs-day__dot\" aria-hidden=\"true\"></span>\n        <div class=\"gs-day__card gs-day__card--start\">\n          <span class=\"gs-day__time\"><span class=\"gs-day__spark\" aria-hidden=\"true\">&#10035;</span>Утро, с 6:00 до 9:00</span>\n          <p class=\"gs-day__text\">Курьер привозит сумку с едой на день. Слоты доставки: с 6:00 до 9:00 и с 20:00 до 22:00.</p>\n        </div>\n      </li>\n      <li class=\"gs-day__stop\">\n        <span class=\"gs-day__dot\" aria-hidden=\"true\"></span>\n        <article class=\"gs-day__card\">\n          <img class=\"gs-day__img\" src=\"/meals_uploads/6b650fd8-d551-4785-b7a5-78fdd7fd714e.png\"\n               alt=\"Кесадилья с яичным паштетом\" width=\"340\" height=\"250\" loading=\"lazy\" decoding=\"async\">\n          <div class=\"gs-day__body\">\n            <span class=\"gs-day__meal\">Завтрак</span>\n            <h3 class=\"gs-day__name\">Кесадилья с яичным паштетом</h3>\n            <p class=\"gs-day__facts\">459&nbsp;ккал · 230&nbsp;г · Б36 Ж18 У39</p>\n          </div>\n        </article>\n      </li>\n      <li class=\"gs-day__stop\">\n        <span class=\"gs-day__dot\" aria-hidden=\"true\"></span>\n        <article class=\"gs-day__card\">\n          <img class=\"gs-day__img\" src=\"/meals_uploads/af1732f8-646f-4451-b7b7-c2dab279ff87.png\"\n               alt=\"Куриная грудинка с запеченным картофелем\" width=\"340\" height=\"250\" loading=\"lazy\" decoding=\"async\">\n          <div class=\"gs-day__body\">\n            <span class=\"gs-day__meal\">Обед</span>\n            <h3 class=\"gs-day__name\">Куриная грудинка с запеченным картофелем</h3>\n            <p class=\"gs-day__facts\">318&nbsp;ккал · 230&nbsp;г · Б37 Ж11 У18</p>\n          </div>\n        </article>\n      </li>\n      <li class=\"gs-day__stop\">\n        <span class=\"gs-day__dot\" aria-hidden=\"true\"></span>\n        <article class=\"gs-day__card\">\n          <img class=\"gs-day__img\" src=\"/meals_uploads/7065d577-c00b-47b4-a370-a2fe47511c40.png\"\n               alt=\"Зеленый салат с брокколи и цитрусами\" width=\"340\" height=\"250\" loading=\"lazy\" decoding=\"async\">\n          <div class=\"gs-day__body\">\n            <span class=\"gs-day__meal\">Полдник</span>\n            <h3 class=\"gs-day__name\">Зеленый салат с брокколи и цитрусами</h3>\n            <p class=\"gs-day__facts\">97&nbsp;ккал · 85&nbsp;г · Б1 Ж8 У5</p>\n          </div>\n        </article>\n      </li>\n      <li class=\"gs-day__stop\">\n        <span class=\"gs-day__dot\" aria-hidden=\"true\"></span>\n        <article class=\"gs-day__card\">\n          <img class=\"gs-day__img\" src=\"/meals_uploads/319ac4ae-4842-4ce3-b17c-310e34afdc4e.png\"\n               alt=\"Поке с курицей\" width=\"340\" height=\"250\" loading=\"lazy\" decoding=\"async\">\n          <div class=\"gs-day__body\">\n            <span class=\"gs-day__meal\">Ужин</span>\n            <h3 class=\"gs-day__name\">Поке с курицей</h3>\n            <p class=\"gs-day__facts\">363&nbsp;ккал · 285&nbsp;г · Б13 Ж23 У27</p>\n          </div>\n        </article>\n      </li>\n    </ol>\n    <div class=\"gs-day__total\">\n      <span class=\"gs-day__sum\">Итого за день: 1&nbsp;237&nbsp;ккал</span>\n      <a class=\"gs-btn gs-btn--big\" href=\"#orderFunnel\" data-cta=\"day-order\">Собрать свой день</a>\n    </div>\n  </div>\n</section>"
  }
}
