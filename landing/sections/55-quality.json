{
  "type": "html",
  "props": {
    "content": "<style>\n.gs-qual{background:var(--l-bg-soft,#F2F2F2);padding:var(--gs-sp-7,48px) 20px}\n.gs-qual__in{max-width:1120px;margin:0 auto}\n.gs-qual__h{margin:0 0 var(--gs-sp-5,24px);color:var(--l-green-dark,#194536);\n  font:700 var(--gs-fs-h2,1.5625rem)/1.15 var(--gs-display,\"Loos Wide\",Arial,sans-serif)}\n.gs-qual__grid{display:grid;grid-template-columns:1fr;gap:var(--gs-sp-3,12px)}\n.gs-qual__card{background:#fff;border-radius:var(--gs-r-card,16px);\n  padding:var(--gs-sp-4,16px) var(--gs-sp-4,16px) var(--gs-sp-5,24px)}\n.gs-qual__tag{display:inline-block;margin:0 0 var(--gs-sp-2,8px);padding:4px 10px;\n  border-radius:var(--gs-r-pill,999px);background:var(--l-bg-lime,#EAF3DF);\n  color:var(--l-green-dark,#194536);\n  font:700 var(--gs-fs-xs,.75rem)/1.4 var(--gs-text,\"Museo Sans Cyrl\",Arial,sans-serif);\n  letter-spacing:.02em;text-transform:uppercase}\n.gs-qual__t{margin:0 0 var(--gs-sp-1,4px);color:var(--l-green-dark,#194536);\n  font:700 var(--gs-fs-h3,1.3125rem)/1.25 var(--gs-display,\"Loos Wide\",Arial,sans-serif)}\n.gs-qual__p{margin:0;color:var(--l-ink,#181717);\n  font:400 var(--gs-fs-body,1rem)/1.5 var(--gs-text,\"Museo Sans Cyrl\",Arial,sans-serif)}\n@media (min-width:600px){.gs-qual__grid{grid-template-columns:repeat(2,1fr);gap:var(--gs-sp-4,16px)}}\n</style>\n<section class=\"gs-qual\" aria-labelledby=\"gsQualH\">\n  <div class=\"gs-qual__in\">\n    <h2 class=\"gs-qual__h\" id=\"gsQualH\">Качество и безопасность</h2>\n    <div class=\"gs-qual__grid\">\n      <div class=\"gs-qual__card\">\n        <span class=\"gs-qual__tag\">ISO 22000 и Халал</span>\n        <p class=\"gs-qual__t\">Сертифицированное производство в Алматы</p>\n        <p class=\"gs-qual__p\">Блюда готовятся на собственном производстве, оснащённом по международным стандартам.</p>\n      </div>\n      <div class=\"gs-qual__card\">\n        <span class=\"gs-qual__tag\">Без консервантов</span>\n        <p class=\"gs-qual__t\">Cook &amp; Chill и упаковка MAP</p>\n        <p class=\"gs-qual__p\">Газомодифицированная среда сохраняет свежесть, вкус и пользу без консервантов.</p>\n      </div>\n      <div class=\"gs-qual__card\">\n        <span class=\"gs-qual__tag\">Лабораторный контроль</span>\n        <p class=\"gs-qual__t\">Независимые лаборатории</p>\n        <p class=\"gs-qual__p\">Образцы продукции регулярно отправляются на проверку.</p>\n      </div>\n      <div class=\"gs-qual__card\">\n        <span class=\"gs-qual__tag\">КБЖУ под цель</span>\n        <p class=\"gs-qual__t\">Нутрициологи и технологи</p>\n        <p class=\"gs-qual__p\">Меню и расчёт калорийности составляют нутрициологи и технологи.</p>\n      </div>\n    </div>\n  </div>\n</section>"
  }
}