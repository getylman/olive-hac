{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-feats-css\">\n/* v7 skin: donor feature cards (research/donor-v7.html:290-301). Copy carries over the\n   verified advantages of the previous round; the three photos are Olive's own marketing\n   assets, referenced root-relative (same-origin on olive.kz; validate.py counts only absolute/protocol-relative as external), each curl-verified 200 on 2026-08-16 (SKIN_V7 §4).\n   Photos ride as background-image over the spring gradient: a failed load degrades to the\n   gradient silently — no broken-image glyph, no onerror handler needed. */\n.gs-feats{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:30px;text-align:left}\n.gs-feat{background:#fff;border:1px solid var(--gs7-line,rgba(32,39,26,.12));\n  border-radius:var(--gs-r-big,26px);overflow:hidden;\n  box-shadow:var(--gs-sh-card,0 14px 30px -18px rgba(32,39,26,.22))}\n.gs-feat .gs-imgbox{aspect-ratio:4/3}\n.gs-feat .gs-imgbox::before{font-size:44px}\n.gs-feat__img--1{background:url(\"/assets/images/features/3.webp\") center/cover no-repeat,linear-gradient(140deg,#DCEBC4,#C3DF9C)}\n.gs-feat__img--2{background:url(\"/assets/images/features/4.webp\") center/cover no-repeat,linear-gradient(140deg,#DCEBC4,#C3DF9C)}\n.gs-feat__img--3{background:url(\"/assets/images/features/2.webp\") center/cover no-repeat,linear-gradient(140deg,#DCEBC4,#C3DF9C)}\n.gs-feat__b{padding:16px 18px 18px}\n.gs-feat__t{margin:0 0 6px;font:800 1.1875rem/1.15 var(--gs-display,system-ui,sans-serif);\n  letter-spacing:-.03em;color:var(--gs7-ink,#20271A)}\n.gs-feat__d{margin:0;font:500 .84375rem/1.5 var(--gs-text,sans-serif);color:var(--gs7-muted,#697260)}\n@media (min-width:768px){.gs-feats{grid-template-columns:repeat(4,1fr);gap:16px}}\n</style>\n<section class=\"gs-sec gs-sec--soft\" aria-labelledby=\"gsFeatsH\">\n  <div class=\"gs-wrap gs-center\">\n    <h2 class=\"gs-h2\" id=\"gsFeatsH\">Почему O-live</h2>\n    <div class=\"gs-feats\">\n      <div class=\"gs-feat\"><div class=\"gs-imgbox gs-imgbox--photo gs-feat__img--1\" aria-hidden=\"true\"></div>\n        <div class=\"gs-feat__b\"><h3 class=\"gs-feat__t\">297 блюд в меню</h3>\n        <p class=\"gs-feat__d\">КБЖУ рассчитаны для каждого блюда</p></div></div>\n      <div class=\"gs-feat\"><div class=\"gs-imgbox gs-imgbox--photo gs-feat__img--2\" aria-hidden=\"true\"></div>\n        <div class=\"gs-feat__b\"><h3 class=\"gs-feat__t\">Доставка каждый день</h3>\n        <p class=\"gs-feat__d\">Утром 6:00–9:00 или вечером 20:00–22:00 — и в подарочные дни</p></div></div>\n      <div class=\"gs-feat\"><div class=\"gs-imgbox gs-imgbox--photo gs-feat__img--3\" aria-hidden=\"true\"></div>\n        <div class=\"gs-feat__b\"><h3 class=\"gs-feat__t\">Персонализация меню</h3>\n        <p class=\"gs-feat__d\">Заменяйте блюда и исключайте продукты — до 3 предпочтений, доплата видна до оплаты</p></div></div>\n      <div class=\"gs-feat\"><div class=\"gs-imgbox\" data-emoji=\"💳\" aria-hidden=\"true\"></div>\n        <div class=\"gs-feat__b\"><h3 class=\"gs-feat__t\">Оплата картой онлайн</h3>\n        <p class=\"gs-feat__d\">Платёж обрабатывает процессинг Halyk Bank ePay</p></div></div>\n    </div>\n  </div>\n</section>"
  }
}
