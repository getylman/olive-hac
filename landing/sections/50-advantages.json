{
  "type": "html",
  "props": {
    "content": "<style>\n.gs-adv{background:#fff;padding:var(--gs-sp-7,48px) 20px}\n.gs-adv__in{max-width:1120px;margin:0 auto}\n.gs-adv__h{margin:0 0 var(--gs-sp-5,24px);color:var(--l-green-dark,#194536);\n  font:700 var(--gs-fs-h2,1.5625rem)/1.15 var(--gs-display,\"Loos Wide\",Arial,sans-serif);text-wrap:balance}\n.gs-adv__grid{display:grid;grid-template-columns:1fr;gap:var(--gs-sp-3,12px)}\n.gs-adv__card{background:var(--l-bg-lime,#EAF3DF);border-radius:var(--gs-r-card,16px);\n  padding:var(--gs-sp-4,16px) var(--gs-sp-4,16px) var(--gs-sp-5,24px)}\n.gs-adv__t{margin:0 0 var(--gs-sp-2,8px);color:var(--l-green-dark,#194536);\n  font:500 var(--gs-fs-h3,1.3125rem)/1.25 var(--gs-display,\"Loos Wide\",Arial,sans-serif)}\n.gs-adv__t b{font-weight:700;font-size:var(--gs-fs-h2,1.5625rem);line-height:1;\n  font-variant-numeric:tabular-nums}\n.gs-adv__p{margin:0;max-width:60ch;color:var(--l-ink,#181717);\n  font:400 var(--gs-fs-body,1rem)/1.5 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif)}\n@media (min-width:600px){.gs-adv__grid{grid-template-columns:repeat(2,1fr);gap:var(--gs-sp-4,16px)}}\n</style>\n<section class=\"gs-adv\" aria-labelledby=\"gsAdvH\">\n  <div class=\"gs-adv__in\">\n    <h2 class=\"gs-adv__h\" id=\"gsAdvH\">O-live — это:</h2>\n    <div class=\"gs-adv__grid\">\n      <div class=\"gs-adv__card\">\n        <h3 class=\"gs-adv__t\"><b>297</b> блюд в меню</h3>\n        <p class=\"gs-adv__p\">КБЖУ рассчитаны для каждого блюда</p>\n      </div>\n      <div class=\"gs-adv__card\">\n        <h3 class=\"gs-adv__t\"><b>4</b> рациона под цель</h3>\n        <p class=\"gs-adv__p\">1 200 и 1 500 ккал — снижение веса, 1 800 — баланс, 2 500 — набор массы</p>\n      </div>\n      <div class=\"gs-adv__card\">\n        <h3 class=\"gs-adv__t\">Доставка каждый день</h3>\n        <p class=\"gs-adv__p\">Утром 6:00–9:00 или вечером 20:00–22:00 — привозим и в подарочные дни</p>\n      </div>\n      <div class=\"gs-adv__card\">\n        <h3 class=\"gs-adv__t\">Персонализация меню</h3>\n        <p class=\"gs-adv__p\">Заменяйте блюда и исключайте продукты — до 3 предпочтений, доплата видна до оплаты</p>\n      </div>\n    </div>\n  </div>\n</section>"
  }
}
