{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-trust-css\">\n/* v7 skin: donor stat cards (research/donor-v7.html:102-105). Figures are deliberate\n   evergreen understatements of live overview (719 customers / 1137 orders on 2026-08-16;\n   they only grow). «заказов» never says «выполненных» — 43% historically go unpaid.\n   NOTE: the gs- token block moved from here to 04-skin.json (single owner). */\n.gs-trust__stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:6px}\n.gs-trust__stat{background:#fff;border:1px solid var(--gs7-line,rgba(32,39,26,.12));\n  border-radius:20px;padding:20px 10px;text-align:center}\n.gs-trust__v{font:800 clamp(1.5rem,6vw,2.25rem)/1 var(--gs-display,system-ui,sans-serif);\n  letter-spacing:-.04em;color:var(--gs7-green,#3F6B39);font-variant-numeric:tabular-nums}\n.gs-trust__l{margin-top:8px;font:600 .8125rem/1.35 var(--gs-text,sans-serif);color:var(--gs7-muted,#697260)}\n.gs-trust__pay{margin:24px 0 0;font:600 var(--gs-fs-sm,.875rem)/1.5 var(--gs-text,sans-serif);\n  color:var(--gs7-muted,#697260)}\n.gs-trust__telrow{margin:4px 0 0}\n.gs-trust__tel{display:inline-flex;align-items:center;min-height:44px;padding:0 8px;\n  color:var(--gs7-green,#3F6B39);text-decoration:underline;text-underline-offset:3px;\n  font:700 1.0625rem/1.4 var(--gs-text,sans-serif);font-variant-numeric:tabular-nums;white-space:nowrap}\n.gs-trust__tel:hover,.gs-trust__tel:focus{color:var(--gs7-deep,#2C4E28)}\n@media (min-width:768px){.gs-trust__stats{max-width:760px;margin-left:auto;margin-right:auto}}\n</style>\n<section class=\"gs-sec\" aria-label=\"O-live в цифрах\">\n  <div class=\"gs-wrap gs-center\">\n    <div class=\"gs-trust__stats\">\n      <div class=\"gs-trust__stat\"><div class=\"gs-trust__v\">700+</div><div class=\"gs-trust__l\">клиентов в Алматы</div></div>\n      <div class=\"gs-trust__stat\"><div class=\"gs-trust__v\">1 100+</div><div class=\"gs-trust__l\">заказов</div></div>\n      <div class=\"gs-trust__stat\"><div class=\"gs-trust__v\">297</div><div class=\"gs-trust__l\">блюд в меню</div></div>\n    </div>\n    <p class=\"gs-trust__pay\">Оплата картой — платёж обрабатывает Halyk Bank ePay</p>\n    <p class=\"gs-trust__telrow\"><a class=\"gs-trust__tel\" href=\"tel:+77008702626\" data-cta=\"trust-phone\">+7 700 870-26-26</a></p>\n  </div>\n</section>"
  }
}
