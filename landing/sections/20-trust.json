  "props": {
    "content": "<style>\n:root{\n  --gs-sp-1:4px;--gs-sp-2:8px;--gs-sp-3:12px;--gs-sp-4:16px;--gs-sp-5:24px;\n  --gs-sp-6:32px;--gs-sp-7:48px;--gs-sp-8:64px;\n  --gs-r-btn:6px;--gs-r-input:10px;--gs-r-card:16px;--gs-r-big:18px;--gs-r-pill:999px;\n  --gs-sh-card:0 10px 30px rgba(0,0,0,.08);--gs-sh-bar:0 -4px 20px rgba(0,0,0,.12);\n  --gs-fs-hero:clamp(1.875rem,1rem + 3.6vw,3.375rem);\n  --gs-fs-h2:clamp(1.5625rem,1.1rem + 2vw,2.5rem);\n  --gs-fs-h3:1.3125rem;--gs-fs-lead:1.125rem;--gs-fs-body:1rem;--gs-fs-sm:.875rem;--gs-fs-xs:.75rem;\n  --gs-display:\"Loos Wide\",Arial,sans-serif;\n  --gs-text:\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif;\n}\n</style>\n<style>\n.gs-trust{background:var(--l-green-dark,#194536);padding:var(--gs-sp-5) 20px}\n.gs-trust__in{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(2,1fr);\n  gap:var(--gs-sp-4) var(--gs-sp-4);align-items:center}\n.gs-trust__item{display:flex;align-items:center;justify-content:center;gap:10px;color:#fff;\n  text-align:center;font:500 var(--gs-fs-sm)/1.4 var(--gs-text)}\n.gs-trust__item b{color:var(--l-lime,#C4F139);font:700 var(--gs-fs-h3)/1 var(--gs-display);\n  font-variant-numeric:tabular-nums;white-space:nowrap}\n.gs-trust__item--stat{flex-direction:column;gap:var(--gs-sp-1)}\n.gs-trust__item--wide{grid-column:1/-1}\n.gs-trust__tel{display:inline-flex;align-items:center;min-height:44px;padding:0 var(--gs-sp-2);\n  color:#fff;text-decoration:underline;text-underline-offset:3px;\n  font:700 var(--gs-fs-sm)/1.4 var(--gs-text);font-variant-numeric:tabular-nums;white-space:nowrap}\n.gs-trust__tel:hover,.gs-trust__tel:focus{color:var(--l-lime,#C4F139)}\n@media (min-width:768px){\n  .gs-trust__in{display:flex;flex-wrap:wrap;justify-content:center;\n    gap:var(--gs-sp-4) var(--gs-sp-6)}\n  .gs-trust__item--stat{flex-direction:row;gap:10px}\n}\n</style>\n<section class=\"gs-trust\" aria-label=\"O-live в цифрах\">\n  <div class=\"gs-trust__in\">\n    <span class=\"gs-trust__item gs-trust__item--stat\"><b>717</b> клиентов в Алматы</span>\n    <span class=\"gs-trust__item gs-trust__item--stat\"><b>1 130</b> заказов</span>\n    <span class=\"gs-trust__item gs-trust__item--wide\">Оплата картой через Halyk Bank ePay</span>\n    <span class=\"gs-trust__item gs-trust__item--wide\"><a class=\"gs-trust__tel\" href=\"tel:+77008702626\" data-cta=\"trust-phone\">+7 700 870-26-26</a></span>\n  </div>\n</section>"
  }
