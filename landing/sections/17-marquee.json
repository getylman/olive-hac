{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-marquee-css\">\n/* Fact ribbon, scroll-velocity marquee (21st.dev dillionverma scroll-based-velocity,\n   rebuilt self-contained). Two rows drift in opposite directions; page scroll velocity\n   boosts the drift and scrolling up reverses it. Without JS the block stays the previous\n   static centred wrapping row with a single copy of the facts, so nothing depends on the\n   script running. Copy is verified only: 297 (meals API), the ration range, and the\n   ISO/Halal and own-Almaty-production claims Olive publishes. */\n.gs-marquee{background:var(--gs7-green,#3F6B39);color:#fff;padding:18px 20px;overflow:hidden}\n.gs-marquee__row{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 20px;\n  max-width:1000px;margin:0 auto}\n.gs-marquee__row[hidden]{display:none}\n.gs-marquee__row span{display:inline-flex;align-items:center;gap:10px;white-space:nowrap;\n  font:800 1rem/1.3 var(--gs-display,system-ui,sans-serif);letter-spacing:-.02em}\n.gs-marquee__row span::before{content:\"\\2733\";color:var(--gs7-gold,#E0A73C);font-size:12px}\n/* live mode: rows become nowrap tracks wider than the viewport, driven by the script */\n.gs-marquee--live{padding:14px 0}\n.gs-marquee--live .gs-marquee__row{flex-wrap:nowrap;justify-content:flex-start;\n  width:max-content;max-width:none;margin:0;gap:0 28px;padding-right:28px;will-change:transform}\n.gs-marquee--live .gs-marquee__row+.gs-marquee__row{margin-top:10px}\n@media (prefers-reduced-motion:reduce){.gs-marquee--live .gs-marquee__row{transform:none!important}}\n</style>\n<div class=\"gs-marquee\" data-gs-vel><div class=\"gs-marquee__row\" data-gs-vel-row data-gs-dir=\"-1\"><span>297 блюд</span><span>1 200–2 500 ккал</span><span>Без консервантов</span><span>ISO 22000 и Халал</span><span>Готовим в Алматы</span></div><div class=\"gs-marquee__row\" data-gs-vel-row data-gs-dir=\"1\" hidden aria-hidden=\"true\"><span>297 блюд</span><span>1 200–2 500 ккал</span><span>Без консервантов</span><span>ISO 22000 и Халал</span><span>Готовим в Алматы</span></div></div>\n<script>\n(function(){\n  /* The first row alone is the no-JS state (single copy, wrapped, centred). Live mode\n     quadruples each row so wrapping modulo a quarter of the row width is seamless,\n     un-hides the counter-row and drives both with a shared scroll-velocity boost. */\n  var box=document.querySelector('[data-gs-vel]');\n  if(!box)return;\n  if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;\n  var rows=[].slice.call(box.querySelectorAll('[data-gs-vel-row]'));\n  if(!rows.length)return;\n  rows.forEach(function(r){var h=r.innerHTML;r.innerHTML=h+h+h+h;r.hidden=false;});\n  box.classList.add('gs-marquee--live');\n  var st=rows.map(function(r){return {el:r,dir:parseFloat(r.getAttribute('data-gs-dir'))||-1,x:0,q:0};});\n  function measure(){st.forEach(function(s){s.q=s.el.scrollWidth/4||0;});}\n  measure();\n  window.addEventListener('resize',measure);\n  var boost=0,lastY=window.pageYOffset||0;\n  var BASE=.5,GAIN=.25,MAX=12,DECAY=.92;\n  function tick(){\n    var y=window.pageYOffset||0;\n    boost+=(y-lastY)*GAIN;lastY=y;\n    if(boost>MAX)boost=MAX;if(boost<-MAX)boost=-MAX;\n    boost*=DECAY;\n    st.forEach(function(s){\n      if(!s.q)return;\n      s.x+=s.dir*(BASE+boost);\n      s.x=((s.x%s.q)+s.q)%s.q;\n      s.el.style.transform='translateX('+(s.x-s.q)+'px)';\n    });\n    window.requestAnimationFrame(tick);\n  }\n  window.requestAnimationFrame(tick);\n})();\n</script>"
  }
}
