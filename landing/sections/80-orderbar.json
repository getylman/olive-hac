{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-summary-css\">\n/* LK round: Level Kitchen's floating order summary — the block the brief named\n   «container summary-main summary-container» (levelkitchen.com/spb, inspected 2026-08-16:\n   position:fixed; bottom:1rem; centered; z-index high; fade+slide transition; on mobile a\n   full-width CTA pill, on desktop a centered summary card).\n   Named .gs-summary here, not with LK's own class names, because bare `container` is a\n   live Bootstrap class on olive.kz (it would inject its own max-width/padding into a fixed\n   bar) and CLAUDE.md requires our markup to stay gs--scoped.\n\n   It mirrors the real funnel selection read-only — it never writes to the funnel, never\n   dispatches events into it, and carries no order logic. Before any selection it shows the\n   standing offer. Geometry matches the funnel's own bottom bar (09z-configurator styles\n   .of-mbar identically), and this bar hides itself whenever the funnel is on screen, so\n   exactly one summary bar is ever visible. */\n.gs-summary{position:fixed;left:12px;right:12px;bottom:12px;\n  bottom:calc(12px + env(safe-area-inset-bottom));z-index:900;\n  max-width:640px;margin:0 auto;background:var(--gs7-ink,#20271A);border-radius:22px;\n  padding:12px 14px;box-shadow:0 18px 40px -16px rgba(32,39,26,.55);\n  transition:transform .35s ease,opacity .35s ease}\n.gs-summary--hidden{transform:translateY(140%);opacity:0;pointer-events:none}\n.gs-summary__trust{margin:0 0 8px;text-align:center;\n  font:600 11px/1.35 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  color:#B9C4AF}\n.gs-summary__row{display:flex;align-items:center;gap:12px}\n.gs-summary__info{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}\n.gs-summary__line{font:800 1.0625rem/1.15 var(--gs-display,system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  letter-spacing:-.03em;color:#fff;font-variant-numeric:tabular-nums;\n  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n/* the sub is allowed two lines: once the funnel is driving it, it carries plan +\n   duration + gift and would otherwise be ellipsised down to the ration alone */\n.gs-summary__sub{font:600 12px/1.35 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);\n  color:#C3DF9C;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}\n.gs-summary__btn{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;\n  min-height:52px;padding:14px 18px;background:var(--gs7-green,#3F6B39);color:#fff;\n  border-radius:999px;text-decoration:none;text-align:center;\n  font:700 1rem/1.05 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif)}\n.gs-summary__btn:hover,.gs-summary__btn:focus{background:var(--gs7-green2,#4E8046);color:#fff;text-decoration:none}\n/* the bar floats over the page, so the document reserves its height; the reserved strip\n   is painted in the footer's own wash instead of the default white, which otherwise shows\n   as a bright band under .sf-footer (verified on the live render of draft 1334) */\n:root{scroll-padding-bottom:120px}\nbody{padding-bottom:116px;background:var(--gs7-soft,#F4F8EE)}\n@media (prefers-reduced-motion:reduce){.gs-summary{transition:none}}\n</style>\n<div class=\"gs-summary gs-summary--hidden\" role=\"region\" aria-label=\"Ваш заказ\">\n  <p class=\"gs-summary__trust\">ISO 22000 · Халал · оплата картой через Halyk Bank ePay</p>\n  <div class=\"gs-summary__row\">\n    <span class=\"gs-summary__info\">\n      <span class=\"gs-summary__line\" data-gs-line>от 5 000 ₸/день</span>\n      <span class=\"gs-summary__sub\" data-gs-sub>14 дней + 14 в подарок</span>\n    </span>\n    <a class=\"gs-summary__btn\" href=\"#orderFunnel\" data-cta=\"summary\" data-gs-btn>Собрать рацион</a>\n  </div>\n</div>\n<script>\n(function(){\n  var bar=document.querySelector('.gs-summary');\n  if(!bar)return;\n  var funnel=document.getElementById('orderFunnel');\n  var line=bar.querySelector('[data-gs-line]');\n  var sub=bar.querySelector('[data-gs-sub]');\n  var btn=bar.querySelector('[data-gs-btn]');\n\n  /* read-only mirror of the funnel's own live nodes, all written by order-funnel.js;\n     nothing here ever writes back. [data-total-sum] is the subscription total but only\n     exists on the checkout screen, so the menu/preview screens fall back to\n     [data-price-perday] — verified on the live render of draft 1331, where a user who has\n     chosen a ration but not reached checkout has perday + [data-pdd-label] +\n     [data-selected-plan-title] and no total at all. */\n  function txt(el){return el?String(el.textContent||'').replace(/\\s+/g,' ').trim():'';}\n  function sync(){\n    if(!funnel)return;\n    var total=txt(funnel.querySelector('[data-total-sum]'));\n    var perday=txt(funnel.querySelector('[data-price-perday]'));\n    var head=(total&&total!=='—')?total:((perday&&perday!=='—')?perday+'/день':'');\n    if(!head)return;                               /* nothing chosen yet — keep the offer */\n    var plan=txt(funnel.querySelector('[data-selected-plan-title]'));\n    var days=txt(funnel.querySelector('[data-pdd-label]'));\n    if(days==='Длительность')days='';\n    line.textContent=head;\n    var parts=[];\n    if(plan)parts.push(plan);\n    if(days)parts.push(days);\n    if(parts.length)sub.textContent=parts.join(' · ');\n    btn.textContent='Продолжить';\n  }\n  if(funnel&&window.MutationObserver){\n    var queued=false;\n    var mo=new MutationObserver(function(){\n      if(queued)return;\n      queued=true;\n      window.requestAnimationFrame(function(){queued=false;sync();});\n    });\n    mo.observe(funnel,{childList:true,subtree:true,characterData:true});\n  }\n\n  /* visibility: the funnel carries its own bottom bar, so ours steps aside while the\n     funnel is on screen. Without IntersectionObserver the bar simply stays visible. */\n  if(!funnel||!('IntersectionObserver' in window)){\n    bar.classList.remove('gs-summary--hidden');\n    return;\n  }\n  new IntersectionObserver(function(entries){\n    var e=entries[entries.length-1];\n    bar.classList.toggle('gs-summary--hidden',e.isIntersecting);\n  }).observe(funnel);\n})();\n</script>"
  }
}