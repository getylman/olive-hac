{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-orderbar-css\">\n.gs-orderbar{position:fixed;left:0;right:0;bottom:0;z-index:900;background:rgba(255,255,255,.95);\n-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);\nborder-top:1px solid var(--gs7-line,rgba(32,39,26,.12));\nbox-shadow:var(--gs-sh-bar,0 -4px 20px rgba(32,39,26,.12));\npadding:10px 16px calc(10px + env(safe-area-inset-bottom));\ndisplay:flex;align-items:center;gap:12px;\ntransition:transform .25s ease}\n.gs-orderbar--hidden{transform:translateY(110%)}\n.gs-orderbar__offer{flex:0 0 auto;font:700 var(--gs-fs-xs,.75rem)/1.3 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);color:var(--gs7-deep,#2C4E28);text-transform:uppercase;letter-spacing:.04em}\n.gs-orderbar__price{font:800 1.0625rem/1.2 var(--gs-display,system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);letter-spacing:-.03em;color:var(--gs7-green,#3F6B39);font-variant-numeric:tabular-nums;text-transform:none}\n.gs-orderbar__btn{flex:1;display:flex;justify-content:center;align-items:center;min-height:56px;padding:8px 16px;background:var(--gs7-green,#3F6B39);color:#fff;border-radius:999px;font:700 1.0625rem/1.05 var(--gs-text,\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif);text-align:center;text-decoration:none;box-shadow:0 12px 24px -12px var(--gs7-deep,#2C4E28)}\n.gs-orderbar__btn:hover,.gs-orderbar__btn:focus{background:var(--gs7-green2,#4E8046);color:#fff;text-decoration:none}\n@media (min-width:768px){.gs-orderbar{display:none}}\n@media (prefers-reduced-motion:reduce){.gs-orderbar{transition:none}}\n:root{scroll-padding-bottom:96px}\n@media (max-width:767px){body{padding-bottom:96px}}\n</style>\n<nav class=\"gs-orderbar gs-orderbar--hidden\" aria-label=\"Заказ\">\n<span class=\"gs-orderbar__offer\"><b class=\"gs-orderbar__price\">от 5 000 ₸/день</b><br>+14 дней в подарок</span>\n<a class=\"gs-orderbar__btn\" href=\"#orderFunnel\" data-cta=\"orderbar\">Собрать рацион</a>\n</nav>\n<script>\n(function(){\n  var bar=document.querySelector('.gs-orderbar');\n  if(!bar)return;\n  var f=document.getElementById('orderFunnel');\n  if(!f||!('IntersectionObserver' in window)){bar.classList.remove('gs-orderbar--hidden');return;}\n  new IntersectionObserver(function(es){\n    bar.classList.toggle('gs-orderbar--hidden',es[es.length-1].isIntersecting);\n  }).observe(f);\n})();\n</script>"
  }
}
