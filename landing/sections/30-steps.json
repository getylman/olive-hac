{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-steps-css\">\n/* v7 skin: copy unchanged from the A1 round (matrix-true); donor card geometry. */\n.gs-stepsec .gs-steps{display:grid;gap:14px;margin-top:30px;text-align:left}\n@media (min-width:768px){.gs-stepsec .gs-steps{grid-template-columns:repeat(3,1fr)}}\n.gs-step{background:#fff;border:1px solid var(--gs7-line,rgba(32,39,26,.12));\n  border-radius:var(--gs-r-card,22px);box-shadow:var(--gs-sh-card,0 14px 30px -18px rgba(32,39,26,.22));\n  padding:24px 20px;display:flex;gap:16px;align-items:flex-start}\n.gs-step__n{flex:0 0 44px;height:44px;border-radius:50%;background:var(--gs7-spring,#DCEBC4);\n  color:var(--gs7-deep,#2C4E28);display:flex;align-items:center;justify-content:center;\n  font:800 1.3125rem/1 var(--gs-display,system-ui,sans-serif)}\n.gs-step h3{margin:0 0 4px;font:800 1.1875rem/1.2 var(--gs-display,system-ui,sans-serif);\n  letter-spacing:-.02em;color:var(--gs7-ink,#20271A);text-wrap:balance}\n.gs-step p{margin:0;max-width:60ch;font:400 var(--gs-fs-sm,.875rem)/1.55 var(--gs-text,sans-serif);\n  color:var(--gs7-muted,#697260)}\n</style>\n<section class=\"gs-sec gs-sec--soft gs-stepsec\">\n  <div class=\"gs-wrap gs-center\">\n    <h2 class=\"gs-h2\">Как это работает</h2>\n    <div class=\"gs-steps\">\n      <div class=\"gs-step\"><span class=\"gs-step__n\">1</span><div>\n        <h3>Выберите рацион и длительность</h3>\n        <p>1 200–2 500 ккал; на тарифах 14 и 30 дней дни удваиваются: 14+14 и 30+30.</p>\n      </div></div>\n      <div class=\"gs-step\"><span class=\"gs-step__n\">2</span><div>\n        <h3>Подтвердите адрес и оплатите картой</h3>\n        <p>Полный тариф 14 дней — от 140 000 ₸ (на рационе 1 200 ккал): это 28 дней еды, по 5 000 ₸ в день. Доставка — от 600 до 2 100 ₸ за каждый день доставки, есть зона бесплатной; стоимость доставки за весь заказ покажем до оплаты. Оплата картой через Halyk Bank ePay.</p>\n      </div></div>\n      <div class=\"gs-step\"><span class=\"gs-step__n\">3</span><div>\n        <h3>Получайте готовую еду каждый день</h3>\n        <p>КБЖУ посчитаны, блюда можно заменять при оформлении.</p>\n      </div></div>\n    </div>\n  </div>\n</section>"
  }
}
