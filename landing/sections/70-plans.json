{
  "type": "html",
  "props": {
    "content": "<style class=\"gs-plansmini-css\">\n/* Closing strip (user round: «закрывашка в 3 раза меньше, только нижняя часть»).\n   The full tariff section moved into the funnel (screen 1 calories, screen 2 days),\n   so this is a thin reminder bar: four mini chips plus one CTA. Figures are the same\n   verified OLIVE_PRICING floors as before (1 200 ккал ration is the cheapest, hence\n   «от»): 1/5 дней 10 000 в день; 14/30 дней 5 000 за день еды with the same number of\n   gift days. data-cta values plan-card-* and plans-order are unchanged on purpose. */\n.gs-plansmini{padding:26px 0 30px;background:var(--gs7-soft,#F4F8EE)}\n.gs-plansmini__t{display:block;text-align:center;margin:0 0 12px;\n  font:800 1.25rem/1.2 var(--gs-display,system-ui,sans-serif);letter-spacing:-.03em;\n  color:var(--gs7-ink,#20271A)}\n.gs-plansmini__row{display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:760px;margin:0 auto}\n.gs-plansmini__chip{display:flex;flex-direction:column;gap:2px;align-items:flex-start;\n  background:#fff;border:1.5px solid #E3E8DE;border-radius:12px;padding:9px 12px;\n  text-decoration:none}\n.gs-plansmini__chip:hover,.gs-plansmini__chip:focus-visible{border-color:var(--gs7-green,#3F6B39)}\n.gs-plansmini__chip--best{border-color:var(--gs7-green,#3F6B39);background:var(--gs7-spring,#DCEBC4)}\n.gs-plansmini__d{font:800 .9375rem/1.2 var(--gs-text,sans-serif);color:var(--gs7-ink,#20271A);\n  font-variant-numeric:tabular-nums}\n.gs-plansmini__p{font:700 .75rem/1.3 var(--gs-text,sans-serif);color:var(--gs7-deep,#2C4E28);\n  font-variant-numeric:tabular-nums}\n.gs-plansmini__foot{display:flex;margin-top:12px}\n.gs-plansmini__foot .gs-btn{flex:1;max-width:760px;margin:0 auto}\n@media (min-width:768px){\n  .gs-plansmini__row{grid-template-columns:repeat(4,1fr)}\n  .gs-plansmini__foot .gs-btn{flex:0 1 auto;padding:14px 44px}}\n</style>\n<section class=\"gs-plansmini\" id=\"gsPlans\">\n  <div class=\"gs-wrap\">\n    <span class=\"gs-plansmini__t\">Ваш тариф</span>\n    <div class=\"gs-plansmini__row\">\n      <a class=\"gs-plansmini__chip\" href=\"#orderFunnel\" data-cta=\"plan-card-1\">\n        <span class=\"gs-plansmini__d\">1 день</span>\n        <span class=\"gs-plansmini__p\">от&nbsp;10&nbsp;000&nbsp;₸ в&nbsp;день</span>\n      </a>\n      <a class=\"gs-plansmini__chip\" href=\"#orderFunnel\" data-cta=\"plan-card-5\">\n        <span class=\"gs-plansmini__d\">5 дней</span>\n        <span class=\"gs-plansmini__p\">от&nbsp;10&nbsp;000&nbsp;₸ в&nbsp;день</span>\n      </a>\n      <a class=\"gs-plansmini__chip gs-plansmini__chip--best\" href=\"#orderFunnel\" data-cta=\"plan-card-14\">\n        <span class=\"gs-plansmini__d\">14 дней +14&nbsp;в&nbsp;подарок</span>\n        <span class=\"gs-plansmini__p\">от&nbsp;5&nbsp;000&nbsp;₸ за&nbsp;день&nbsp;еды</span>\n      </a>\n      <a class=\"gs-plansmini__chip\" href=\"#orderFunnel\" data-cta=\"plan-card-30\">\n        <span class=\"gs-plansmini__d\">30 дней +30&nbsp;в&nbsp;подарок</span>\n        <span class=\"gs-plansmini__p\">от&nbsp;5&nbsp;000&nbsp;₸ за&nbsp;день&nbsp;еды</span>\n      </a>\n    </div>\n    <div class=\"gs-plansmini__foot\">\n      <a class=\"gs-btn\" href=\"#orderFunnel\" data-cta=\"plans-order\">Заказать</a>\n    </div>\n  </div>\n</section>"
  }
}
