{
  "meta": {
    "title": "Правильное питание с доставкой — O-live Алматы",
    "theme": {
      "primary": "#C4F139",
      "primaryHover": "#D5FA6B",
      "primaryDark": "#194536",
      "ink": "#181717",
      "bgSoft": "#F2F2F2",
      "bgAccent": "#EAF3DF"
    },
    "overrides": [
      { "selector": ".sf-notice--fixed", "style": "position:static" },
      { "selector": ".sf-header", "style": "background:#fff;color:#194536" }
    ]
