  "sections": [
    {
      "type": "html",
      "props": {
        "content": "<style>:root{--gs-sp-2:8px;--gs-sp-3:12px;--gs-sp-4:16px;--gs-sp-5:24px;--gs-sp-7:48px;--gs-r-btn:6px;--gs-r-card:16px;--gs-r-pill:999px;--gs-sh-card:0 10px 30px rgba(0,0,0,.08);--gs-sh-bar:0 -4px 20px rgba(0,0,0,.12);--gs-fs-hero:clamp(1.875rem,1rem + 3.6vw,3.375rem);--gs-fs-h3:1.3125rem;--gs-fs-lead:1.125rem;--gs-fs-sm:.875rem;--gs-fs-xs:.75rem;--gs-display:\"Loos Wide\",Arial,sans-serif;--gs-text:\"Museo Sans Cyrl\",-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif}\n.gs-hero{background:var(--l-bg-lime,#EAF3DF);padding:var(--gs-sp-7) 20px}\n.gs-hero__in{max-width:1120px;margin:0 auto;display:flex;flex-direction:column;gap:var(--gs-sp-4)}\n.gs-badge{display:inline-flex;align-items:center;gap:8px;background:var(--l-lime,#C4F139);color:var(--l-green-dark,#194536);border-radius:var(--gs-r-pill);padding:10px 18px;font:700 var(--gs-fs-sm)/1.3 var(--gs-text);text-transform:uppercase;letter-spacing:.04em;align-self:flex-start}\n.gs-hero h1{font:700 var(--gs-fs-hero)/1.05 var(--gs-display);color:var(--l-green-dark,#194536);text-transform:uppercase;margin:0;max-width:16ch}\n.gs-hero__sub{font:500 var(--gs-fs-lead)/1.4 var(--gs-text);color:var(--l-ink,#181717);margin:0;max-width:36ch}\n.gs-hero__cta{display:inline-flex;justify-content:center;align-items:center;min-height:56px;background:var(--l-lime,#C4F139);color:var(--l-green-dark,#194536);border-radius:var(--gs-r-pill);padding:16px 38px;font:500 1.3125rem/1.05 var(--gs-text);text-decoration:none;align-self:flex-start}\n.gs-hero__cta:hover{background:var(--l-lime-hover,#D5FA6B);color:#0A1C14}\n@media (max-width:560px){.gs-hero__cta{width:100%;align-self:stretch}}</style><section class=\"gs-hero\"><div class=\"gs-hero__in\"><span class=\"gs-badge\">Плати за 5 дней — ешь 10</span><h1>Готовое ПП-меню с доставкой по Алматы</h1><p class=\"gs-hero__sub\">Рационы 1 200–2 500 ккал на каждый день. Каждый второй тариф — в подарок: 5+5, 14+14, 30+30 дней.</p><a class=\"gs-hero__cta\" href=\"#order\">Собрать рацион</a></div></section>"
      }
    },
    {
      "type": "html",
      "props": {
        "content": "<style>.gs-trust{background:var(--l-green-dark,#194536);padding:var(--gs-sp-5,24px) 20px}.gs-trust__in{max-width:1120px;margin:0 auto;display:flex;flex-wrap:wrap;gap:16px 32px;justify-content:center}.gs-trust__item{display:flex;align-items:center;gap:10px;color:#fff;font:500 var(--gs-fs-sm,.875rem)/1.4 var(--gs-text,sans-serif)}.gs-trust__item b{color:var(--l-lime,#C4F139);font:700 1.3125rem/1 var(--gs-display,sans-serif);font-variant-numeric:tabular-nums}.gs-trust__item a{color:#fff}</style><section class=\"gs-trust\"><div class=\"gs-trust__in\"><span class=\"gs-trust__item\"><b>717</b> клиентов в Алматы</span><span class=\"gs-trust__item\"><b>1 130</b> выполненных заказов</span><span class=\"gs-trust__item\">Оплата картой через Halyk Bank ePay</span><span class=\"gs-trust__item\"><a href=\"tel:+77008702626\">+7 700 870-26-26</a></span></div></section>"
      }
    },
    {
      "type": "features",
      "props": {
        "heading": "Как это работает",
        "items": [
          { "icon": "1", "title": "Выберите рацион", "text": "1 200–2 500 ккал — меню на каждый день уже составлено." },
          { "icon": "2", "title": "Мы готовим и привозим", "text": "Доставка по Алматы, зоны и тарифы — на карте ниже." },
          { "icon": "3", "title": "Дни в подарок", "text": "Каждый тариф удваивается: 5+5, 14+14, 30+30 дней." }
        ]
      }
    },
    {
      "type": "html",
      "props": {
        "content": "<style>.gs-dishes{display:grid;grid-auto-flow:column;grid-auto-columns:78%;gap:12px;overflow-x:auto;padding:4px 20px 16px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}@media (min-width:768px){.gs-dishes{grid-auto-columns:280px}}.gs-dish{scroll-snap-align:start;background:#fff;border-radius:var(--gs-r-card,16px);box-shadow:var(--gs-sh-card,0 10px 30px rgba(0,0,0,.08));display:flex;flex-direction:column;padding:16px;gap:8px}.gs-dish__name{font:500 1rem/1.3 var(--gs-text,sans-serif);color:var(--l-ink,#181717);margin:0}.gs-dish__kcal{font:700 1.3125rem/1 var(--gs-display,sans-serif);color:var(--l-green-dark,#194536);font-variant-numeric:tabular-nums}.gs-dish__kcal small{font:500 .75rem/1 var(--gs-text,sans-serif);color:var(--l-muted,#5E5E5E)}.gs-dish__macros{display:flex;gap:8px;margin:0;padding:0;list-style:none}.gs-dish__macros li{background:var(--l-bg-soft,#F2F2F2);border-radius:999px;padding:4px 10px;font:500 .75rem/1.3 var(--gs-text,sans-serif);color:var(--l-ink,#181717)}</style><section style=\"padding:48px 0\"><h2 class=\"l-title\">Реальные блюда из меню</h2><div class=\"gs-dishes\"><article class=\"gs-dish\"><h3 class=\"gs-dish__name\">Скрембл с индейкой</h3><div class=\"gs-dish__kcal\">355 ккал <small>· 220 г</small></div><ul class=\"gs-dish__macros\"><li>Б 28</li><li>Ж 24</li><li>У 6</li></ul></article><article class=\"gs-dish\"><h3 class=\"gs-dish__name\">Каша из зелёной гречки с клюквой</h3><div class=\"gs-dish__kcal\">265 ккал <small>· 245 г</small></div><ul class=\"gs-dish__macros\"><li>Б 6</li><li>Ж 6</li><li>У 46</li></ul></article><article class=\"gs-dish\"><h3 class=\"gs-dish__name\">Шарлотка</h3><div class=\"gs-dish__kcal\">138 ккал <small>· 100 г</small></div><ul class=\"gs-dish__macros\"><li>Б 4</li><li>Ж 4</li><li>У 23</li></ul></article></div></section>"
      }
    },
    { "type": "home_advantages", "props": {} },
    { "type": "order_menu", "props": { "heading": "Соберите свой рацион", "subheading": "Оплата за 5 дней — питание на 10", "banner": "5 + 5 дней в подарок" } },
    { "type": "order_filters", "props": {} },
    {
      "type": "faq",
      "props": {
        "heading": "Вопросы и ответы",
        "items": [
          { "q": "Как работают дни в подарок?", "a": "Каждый многодневный тариф удваивается: оплачиваете 5 дней — получаете 10, 14 — получаете 28, 30 — получаете 60." },
          { "q": "Какие рационы есть?", "a": "Четыре плана: 1 200, 1 500, 1 800 и 2 500 ккал. В планах 1 200 и 1 500 — 4 блюда в день, в 1 800 — 5, в 2 500 — 6." }
        ]
      }
    },
    { "type": "home_map", "props": {} },
    {
      "type": "html",
      "props": {
        "content": "<style>.gs-orderbar{position:fixed;left:0;right:0;bottom:0;z-index:900;background:#fff;box-shadow:var(--gs-sh-bar,0 -4px 20px rgba(0,0,0,.12));padding:10px 16px calc(10px + env(safe-area-inset-bottom));display:flex;align-items:center;gap:12px}.gs-orderbar__offer{font:700 .75rem/1.3 var(--gs-text,sans-serif);color:var(--l-green-dark,#194536);text-transform:uppercase;letter-spacing:.04em}.gs-orderbar__btn{flex:1;display:flex;justify-content:center;align-items:center;min-height:56px;background:var(--l-lime,#C4F139);color:var(--l-green-dark,#194536);border-radius:var(--gs-r-btn,6px);font:500 1.125rem/1.05 var(--gs-text,sans-serif);text-decoration:none}.gs-orderbar__btn:hover{background:var(--l-lime-hover,#D5FA6B);color:#0A1C14}@media (min-width:768px){.gs-orderbar{display:none}}body{scroll-padding-bottom:90px}</style><nav class=\"gs-orderbar\" aria-label=\"Заказ\"><span class=\"gs-orderbar__offer\">5 + 5 дней<br>в подарок</span><a class=\"gs-orderbar__btn\" href=\"#order\">Собрать рацион</a></nav>"
      }
    }
  ]
}
